#!/usr/bin/expect -f
# bw-ssh — authenticate to a Bitwarden-password device and hand over the session.
#   bw-ssh ruckus-unleashed      bw-ssh icx7150-c12p
# Auth only, by design: resolves the password from the Keychain-bridged
# Bitwarden session inside this private PTY, completes the device login,
# clears secrets, then connects the live session to the caller — a human
# terminal or an agent's own expect/script wrapper. The caller drives all
# commands per the personal-infra device runbooks (Unleashed: `enable`
# before show/config; ICX: `skip-page-display`; mutation boundaries apply).
# Wrapper authors: avoid (?i)-prefixed expect patterns — the gate-keeper
# glob is case-sensitive and silently never matches 'Password:'.
log_user 0
set timeout 25

set target [lindex $argv 0]
if {$target ni {ruckus-unleashed icx7150-c12p}} {
  puts "usage: bw-ssh <ruckus-unleashed|icx7150-c12p>"
  exit 64
}

if {[catch {exec /usr/bin/security find-generic-password -a $env(USER) -s personal-infra-bitwarden-session -w} session]} {
  puts "KEYCHAIN-ITEM-ABSENT — run bw-bridge first"
  exit 2
}
set env(BW_SESSION) $session
if {[catch {exec -ignorestderr bw get password {Unleashed Login}} pw]} {
  puts "BW-GET-FAILED (session stale/locked, or item missing?) — run bw-bridge"
  exit 3
}

spawn ssh $target

if {$target eq "ruckus-unleashed"} {
  # Application-level login inside the SSH session.
  expect {
    -re {yes/no} { puts "HOSTKEY-PROMPT — refusing to auto-accept"; exit 4 }
    -re {ogin[: ]} { send "seb\r" }
    timeout { puts "TIMEOUT before login prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED before login prompt"; exit 5 }
  }
  expect {
    -re {assword} { send "$pw\r" }
    timeout { puts "TIMEOUT before password prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED before password prompt"; exit 5 }
  }
  set pw ""
  set env(BW_SESSION) ""
  expect {
    -re {ruckus>} {}
    -re {ncorrect|enied|ailed|ogin[: ]} { puts "AUTH-FAILED"; exit 6 }
    timeout { puts "TIMEOUT before CLI prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED after auth attempt"; exit 5 }
  }
} else {
  # ICX: SSH-level password auth.
  expect {
    -re {yes/no} { puts "HOSTKEY-PROMPT — refusing to auto-accept"; exit 4 }
    -re {assword} { send "$pw\r" }
    timeout { puts "TIMEOUT before password prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED before password prompt"; exit 5 }
  }
  set pw ""
  set env(BW_SESSION) ""
  expect {
    -re {@[^\r\n]*[>#]} {}
    -re {assword} { puts "AUTH-FAILED (re-prompted)"; exit 6 }
    timeout { puts "TIMEOUT before CLI prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED after auth attempt"; exit 5 }
  }
}

# Re-print the prompt for the caller, then hand over the session.
send "\r"
interact
