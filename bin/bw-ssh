#!/usr/bin/expect -f
# bw-ssh — authenticate to a Bitwarden-password device and hand over the session.
#   bw-ssh unifi                 bw-ssh pikvm
# `unifi` reaches the UCG-Fiber UniFi OS shell (item "Unifi wl7r", ssh alias
# `unifi`, SSH user root — `wl7r` is the UniFi UI admin name, not the shell
# user). Read-only by default; UniFi OS is managed through its supported
# UI/API — never edit its filesystem or database (core.md section 4).
# Auth only, by design: resolves the password from the Keychain-bridged
# Bitwarden session inside this private PTY, completes the device login,
# clears secrets, then connects the live session to the caller — a human
# terminal or an agent's own expect/script wrapper. The caller drives all
# commands per the personal-infra device runbooks (mutation boundaries apply).
# Credentials resolve by Bitwarden item **id**, never by name: four vault
# items now match the search string "Unifi wl7r", and the CLI refuses an
# ambiguous name with "More than one result was found". Ids are unambiguous
# and survive renames; the human-readable name stays as a comment only.
# Lookups go through the pinned `bw-vault` wrapper (see
# runbooks/access/bitwarden.md) rather than a Homebrew `bw` of unreviewed
# version. Ruckus Unleashed and the ICX switch were factory-reset and
# disconnected; their profiles and vault item are retired, not commented out.
# Wrapper authors: avoid (?i)-prefixed expect patterns — the gate-keeper
# glob is case-sensitive and silently never matches 'Password:'.
log_user 0
set timeout 25

# Bitwarden item ids. Names are documentation; the id is what is resolved.
array set bw_item_id {
  unifi 165435ea-6eb1-4f85-a913-efdaa04bebf9
  pikvm 5759163b-bc59-4727-ba68-b555d8037125
}
# unifi -> "Unifi wl7r"        pikvm -> "pikvm - root"

set target [lindex $argv 0]
if {[llength $argv] != 1 || ![info exists bw_item_id($target)]} {
  puts "usage: bw-ssh <unifi|pikvm>"
  exit 64
}

if {[catch {exec /usr/bin/security find-generic-password -a $env(USER) -s personal-infra-bitwarden-session -w} session]} {
  puts "KEYCHAIN-ITEM-ABSENT — run bw-bridge first"
  exit 2
}
set env(BW_SESSION) $session
set session ""
set bw_vault [file join $env(HOME) .local bin bw-vault]
if {[catch {exec -ignorestderr $bw_vault get password $bw_item_id($target)} pw]} {
  puts "BW-GET-FAILED (session stale/locked, or item id changed) — run bw-bridge"
  exit 3
}
set env(BW_SESSION) ""

if {$target eq "pikvm"} {
  # Canonical ed25519 key is pinned in known_hosts. Never enroll on first use.
  # SSH_ASKPASS delivery + MOTD-safe patterns (2026-08-02): PiKVM's login
  # banner contains the word "password" ("Changing the root password: passwd"),
  # so any post-auth expect on {assword} false-positives on a SUCCESSFUL
  # login — that was the original branch's defect, not the credential.
  # Askpass sidesteps prompt-matching entirely; the password rides a 0600
  # tempfile for the duration of the handshake only. The success pattern
  # matches the colored prompt tail "]# " (ANSI codes sit between the
  # bracket and the username, so {\[root@pikvm...} never matches).
  set pwfile [exec mktemp]
  exec chmod 600 $pwfile
  set pf [open $pwfile w]
  fconfigure $pf -translation binary
  puts -nonewline $pf $pw
  close $pf
  set askfile [exec mktemp]
  set af [open $askfile w]
  puts $af "#!/bin/sh"
  puts $af "cat $pwfile"
  close $af
  exec chmod 700 $askfile
  set pw ""
  set env(SSH_ASKPASS) $askfile
  set env(SSH_ASKPASS_REQUIRE) force
  set env(DISPLAY) :0
  spawn ssh -o StrictHostKeyChecking=yes -o PreferredAuthentications=password,keyboard-interactive -o PubkeyAuthentication=no root@pikvm.wl7r.com
  expect {
    -re {yes/no} { exec rm -f $pwfile $askfile; puts "HOSTKEY-PROMPT — refusing to auto-accept"; exit 4 }
    -re {\]# ?$} {}
    -re {ermission denied} { exec rm -f $pwfile $askfile; puts "AUTH-FAILED"; exit 6 }
    timeout { exec rm -f $pwfile $askfile; puts "TIMEOUT before shell prompt"; exit 5 }
    eof { exec rm -f $pwfile $askfile; puts "CONNECTION-CLOSED during auth"; exit 5 }
  }
  exec rm -f $pwfile $askfile
} else {
  # UniFi OS: SSH-level password auth into a POSIX shell. The console offers
  # keyboard-interactive, not `password`; let ssh negotiate rather than forcing
  # a method (access.yaml, profile unifi-os-ssh).
  spawn ssh $target
  expect {
    -re {yes/no} { puts "HOSTKEY-PROMPT — refusing to auto-accept"; exit 4 }
    -re {assword} { send "$pw\r" }
    timeout { puts "TIMEOUT before password prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED before password prompt"; exit 5 }
  }
  set pw ""
  expect {
    -re {[\$#] $} {}
    -re {assword} { puts "AUTH-FAILED (re-prompted)"; exit 6 }
    -re {ermission denied} { puts "AUTH-FAILED"; exit 6 }
    timeout { puts "TIMEOUT before shell prompt"; exit 5 }
    eof { puts "CONNECTION-CLOSED after auth attempt"; exit 5 }
  }
}

# Re-print the prompt for the caller, then hand over the session.
send "\r"
interact
