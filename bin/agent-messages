#!/usr/bin/env python3
"""Read Sebastian's messages and agent usage from T3's local database, read-only."""
import argparse
from collections import Counter
from contextlib import closing
from datetime import datetime, timedelta, timezone
import json
import math
from pathlib import Path
import re
import shlex
import sqlite3
import sys
from zoneinfo import ZoneInfo

STOCKHOLM = ZoneInfo('Europe/Stockholm')
DATABASE = Path.home() / '.t3' / 'userdata' / 'statev2.sqlite'
HUMAN = """role = 'user'
    AND json_extract(payload_json, '$.createdBy') = 'user'
    AND json_extract(payload_json, '$.creationSource') IN ('web', 'mobile')"""
MESSAGE_WINDOW = 'julianday(created_at) >= julianday(?) AND julianday(created_at) < julianday(?)'
ITEM_WINDOW = 'julianday(updated_at) >= julianday(?) AND julianday(updated_at) < julianday(?)'
TOOL_PREFIXES = ('mcp__t3-code__', 't3-code.')
COMMAND_PATTERNS = {
    'agent-run start': r'(?<![\w-])agent-run\s+start\b',
    'agent-run wait': r'(?<![\w-])agent-run\s+wait\b',
    'hand_rolled_ci_waits': (
        r'\bgh\s+run\s+watch\b|\bgh\s+pr\s+checks\b[^\n;&|]*--watch\b'
        r'|\b(?:until|while)\b(?:(?!\bdone\b)[\s\S])*?\bgh\s+(?:run|pr)\b'),
    'sleep': r'\bsleep\s+',
    'claude -p': r'(?<![\w-])claude\s+(?:[^\n;&|]*?\s)?(?:-p\b|--print\b)',
    'codex exec': r'(?<![\w-])codex\s+exec\b',
}
SHELLS = {'sh', 'bash', 'zsh'}
SHELL_SCRIPT_FLAGS = ('-c', '-lc', '-lic')
OPERATORS = ('&&', '||', ';', '|')
HEREDOC = re.compile(r"<<-?\s*(['\"]?)(\w+)\1")
SUBSTITUTION = re.compile(r'\$\(([^()]*)\)')
SKILL_READ = re.compile(
    r'(?<![\w-])(?:cat|sed|head|tail|nl|less|bat)\b[^\n;&|]*?'
    r'skills/(?:\.system/)?([\w-]+)/SKILL\.md\b')


def iso_time(value):
    """Interpret an ISO time without an offset in Europe/Stockholm."""
    try:
        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
    except ValueError as error:
        raise argparse.ArgumentTypeError(f'invalid ISO time: {value}') from error
    if result.tzinfo is None:
        result = result.replace(tzinfo=STOCKHOLM)
    return result.astimezone(timezone.utc)


def arguments():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('messages', 'usage'):
        command = commands.add_parser(name)
        window = command.add_mutually_exclusive_group()
        window.add_argument('--days', type=float, help='rolling days before now (default: 7)')
        window.add_argument('--since', type=iso_time, help='inclusive ISO time; no offset means Stockholm')
        command.add_argument('--until', type=iso_time, help='exclusive ISO time; requires --since')
    args = parser.parse_args()
    if (args.since is None) != (args.until is None):
        parser.error('--since and --until must be used together')
    if args.since is not None:
        since, until = args.since, args.until
    else:
        days = 7 if args.days is None else args.days
        if not math.isfinite(days) or days <= 0:
            parser.error('--days must be a positive finite number')
        until = datetime.now(timezone.utc)
        try:
            since = until - timedelta(days=days)
        except OverflowError:
            parser.error('--days exceeds the supported date range')
    if since >= until:
        parser.error('--since must be earlier than --until')
    return args.command, (since.isoformat(), until.isoformat())


def unwrapped(command):
    """`command` with each `zsh -lc '<script>'` wrapper (Codex's form) replaced by
    the script it runs; the command itself when it does not parse."""
    try:
        argv = shlex.split(command)
    except ValueError:
        return command
    if not any(Path(word).name in SHELLS for word in argv):
        return command
    parts, i = [], 0
    while i < len(argv):
        word = argv[i]
        if (Path(word).name in SHELLS and i + 2 < len(argv)
                and argv[i + 1] in SHELL_SCRIPT_FLAGS):
            parts.append(argv[i + 2])
            i += 3
            # Skip the `$0` and positional arguments given to the script.
            while i < len(argv) and argv[i] not in OPERATORS:
                i += 1
        else:
            parts.append(word if word in OPERATORS else shlex.quote(word))
            i += 1
    return ' '.join(parts)


def without_heredoc_bodies(script):
    """`script` without the bodies of its heredocs; the opener line, and any
    command after the redirection on it, stays."""
    lines, kept, delimiters = script.split('\n'), [], []
    for line in lines:
        if delimiters:
            if line.strip() == delimiters[0]:
                delimiters.pop(0)
            continue
        kept.append(line)
        delimiters = [match.group(2) for match in HEREDOC.finditer(line)]
    return '\n'.join(kept)


def executable(script):
    """`script` without comments, heredoc bodies and quoted text, so text a
    command only prints or writes is not counted as a command it runs. Command
    substitutions inside double quotes still run, so they stay."""
    script = without_heredoc_bodies(script)
    out, i, n = [], 0, len(script)
    while i < n:
        char = script[i]
        if char == '\\':
            out.append(script[i:i + 2])
            i += 2
        elif char == '#' and (i == 0 or script[i - 1] in ' \t\n;&|('):
            end = script.find('\n', i)
            i = n if end < 0 else end
        elif char == "'":
            end = script.find("'", i + 1)
            if end < 0:
                break  # unterminated: the rest is not a command
            out.append("''")
            i = end + 1
        elif char == '"':
            j = i + 1
            while j < n and script[j] != '"':
                j += 2 if script[j] == '\\' else 1
            out.append(' ; '.join(SUBSTITUTION.findall(script[i + 1:j])) or "''")
            i = j + 1
        else:
            out.append(char)
            i += 1
    return ''.join(out)


def messages(db, window):
    query = f"""
        SELECT m.created_at, m.thread_id, t.title, p.title,
               json_extract(m.payload_json, '$.text'),
               (SELECT substr(json_extract(a.payload_json, '$.text'), -700)
                  FROM orchestration_v2_projection_messages AS a
                 WHERE a.thread_id = m.thread_id AND a.role = 'assistant'
                   AND a.created_at < m.created_at
                   AND trim(coalesce(json_extract(a.payload_json, '$.text'), ''),
                            char(9) || char(10) || char(13) || ' ') <> ''
                 ORDER BY a.created_at DESC, a.message_id DESC LIMIT 1)
          FROM orchestration_v2_projection_messages AS m
          LEFT JOIN orchestration_v2_projection_threads AS t ON t.thread_id = m.thread_id
          LEFT JOIN projection_projects AS p ON p.project_id = t.project_id
         WHERE m.message_id IN (
               SELECT message_id FROM orchestration_v2_projection_messages
                WHERE {HUMAN} AND {MESSAGE_WINDOW})
         ORDER BY m.created_at, m.message_id
    """
    for ts, thread_id, title, project, text, tail in db.execute(query, window):
        yield {
            'ts': iso_time(ts).astimezone(STOCKHOLM).isoformat(timespec='minutes'),
            'thread_id': thread_id,
            'thread_title': title,
            'project_title': project,
            'text': text,
            'prev_agent_tail': tail or '',
        }


def usage(db, window):
    # A scheduler dispatch carries its schedule's id; a delegated child's brief
    # lands in a `thread:delegated-task:` thread. Other agent-sent prompts are
    # coordination between threads.
    message_count, thread_count, wakes, heartbeats, briefs, coordination = db.execute(f"""
        SELECT count(*) FILTER (WHERE {HUMAN}),
               count(DISTINCT thread_id) FILTER (WHERE {HUMAN}),
               count(*) FILTER (WHERE scheduled IS NOT NULL),
               count(*) FILTER (WHERE scheduled IS NOT NULL AND (instr(lower(scheduled), 'heartbeat') > 0
                   OR instr(lower(json_extract(payload_json, '$.text')), 'heartbeat') > 0)),
               count(*) FILTER (WHERE agent AND scheduled IS NULL
                   AND thread_id LIKE 'thread:delegated-task:%'),
               count(*) FILTER (WHERE agent AND scheduled IS NULL
                   AND thread_id NOT LIKE 'thread:delegated-task:%')
          FROM (SELECT *, json_extract(payload_json, '$.scheduledTaskId') AS scheduled,
                       role = 'user' AND json_extract(payload_json, '$.createdBy') = 'agent'
                           AND json_extract(payload_json, '$.creationSource') = 'mcp' AS agent
                  FROM orchestration_v2_projection_messages WHERE {MESSAGE_WINDOW})
    """, window).fetchone()
    tools = Counter()
    skills = {'claude': Counter(), 'codex': Counter()}
    questions = 0
    shell = dict.fromkeys(COMMAND_PATTERNS, 0)
    rows = db.execute(f"""
        SELECT i.type, json_extract(i.payload_json, '$.toolName'),
               json_extract(i.payload_json, '$.input.skill'),
               CASE WHEN json_type(i.payload_json, '$.input') = 'text'
                    THEN json_extract(i.payload_json, '$.input')
                    ELSE json_extract(i.payload_json, '$.input.command') END,
               t.default_provider
          FROM orchestration_v2_projection_turn_items AS i
          LEFT JOIN orchestration_v2_projection_threads AS t ON t.thread_id = i.thread_id
         WHERE i.type IN ('dynamic_tool', 'command_execution', 'user_input_request')
           AND julianday(i.updated_at) >= julianday(?) AND julianday(i.updated_at) < julianday(?)
    """, window)
    for kind, name, skill, command, provider in rows:
        if kind == 'dynamic_tool':
            if isinstance(name, str):
                for prefix in TOOL_PREFIXES:
                    if name.startswith(prefix):
                        tools[name.removeprefix(prefix)] += 1
                        break
            if name == 'Skill' and isinstance(skill, str) and skill:
                skills['claude'][skill] += 1
        elif kind == 'user_input_request':
            questions += 1
        elif isinstance(command, str):
            script = unwrapped(command)
            if provider == 'codex':
                # Codex loads a skill by reading its file.
                for name in set(SKILL_READ.findall(without_heredoc_bodies(script))):
                    skills['codex'][name] += 1
            script = executable(script)
            for category, pattern in COMMAND_PATTERNS.items():
                shell[category] += bool(re.search(pattern, script))
    return {
        'sebastian_messages': message_count,
        'threads_with_messages': thread_count,
        'scheduled_wakes': wakes,
        'heartbeat_wakes': heartbeats,
        'delegated_briefs': briefs,
        'agent_coordination_messages': coordination,
        't3_tool_calls': dict(sorted(tools.items())),
        'skill_loads': {runtime: dict(sorted(counts.items())) for runtime, counts in skills.items()},
        'user_input_requests': questions,
        'shell_commands': shell,
    }


def main():
    command, window = arguments()
    try:
        with closing(sqlite3.connect(DATABASE.as_uri() + '?mode=ro', uri=True)) as db:
            # One read transaction keeps both usage queries on the same live snapshot.
            db.execute('BEGIN')
            records = messages(db, window) if command == 'messages' else (usage(db, window),)
            for record in records:
                print(json.dumps(record, ensure_ascii=False))
    except (sqlite3.Error, OSError) as error:
        print(f'agent-messages: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
