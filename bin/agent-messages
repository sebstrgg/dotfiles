#!/usr/bin/env python3
"""Read messages, agent usage and a daily digest from local state, read-only."""
import argparse
from collections import Counter
from contextlib import closing
from datetime import datetime, timedelta, timezone
import json
import math
from pathlib import Path
import re
import runpy
import shlex
import sqlite3
import subprocess
import sys
from zoneinfo import ZoneInfo
from urllib.parse import quote

STOCKHOLM = ZoneInfo('Europe/Stockholm')
DATABASE = Path.home() / '.t3' / 'userdata' / 'statev2.sqlite'
# Sebastian types in the web or mobile app; T3 records his answer to a Codex
# question-tool request as a server message holding the question, then his answer.
HUMAN = """role = 'user'
    AND json_extract(payload_json, '$.createdBy') = 'user'
    AND (json_extract(payload_json, '$.creationSource') IN ('web', 'mobile')
         OR (json_extract(payload_json, '$.creationSource') = 'server'
             AND json_extract(payload_json, '$.id') LIKE 'async-answer:%'))"""
MESSAGE_WINDOW = 'julianday(created_at) >= julianday(?) AND julianday(created_at) < julianday(?)'
ITEM_WINDOW = 'julianday(updated_at) >= julianday(?) AND julianday(updated_at) < julianday(?)'
TOOL_PREFIXES = ('mcp__t3-code__', 't3-code.')
COMMAND_PATTERNS = {
    'agent-run start': r'(?<![\w-])agent-run\s+start\b',
    'agent-run wait': r'(?<![\w-])agent-run\s+wait\b',
    'hand_rolled_ci_waits': (
        r'\bgh\s+run\s+watch\b|\bgh\s+pr\s+checks\b[^\n;&|]*--watch\b'
        r'|\b(?:until|while)\b(?:(?!\bdone\b)[\s\S])*?\bgh\s+(?:run|pr)\b'),
    'sleep': r'\bsleep\s+',
    'claude -p': r'(?<![\w-])claude\s+(?:[^\n;&|]*?\s)?(?:-p\b|--print\b)',
    'codex exec': r'(?<![\w-])codex\s+exec\b',
}
SHELLS = {'sh', 'bash', 'zsh'}
SHELL_SCRIPT_FLAGS = ('-c', '-lc', '-lic')
OPERATORS = ('&&', '||', ';', '|')
# A heredoc opener, or quoted text that may only look like one: one ordered
# scan, so `<<'EOF'` opens a heredoc and `echo '<<EOF'` does not.
HEREDOC = re.compile(r"(?<!<)<<(?!<)-?\s*(['\"]?)(\w+)\1|'[^']*'|\"(?:\\.|[^\"\\])*\"")
SUBSTITUTION = re.compile(r'\$\(([^()]*)\)')
SKILL_READERS = {'cat', 'sed', 'head', 'tail', 'nl', 'less', 'bat'}
SHELL_OPERATORS = {';', '&', '&&', '|', '||', '(', ')'}
SKILL_FILE = re.compile(r'skills/(?:\.system/)?([\w-]+)/SKILL\.md\b')


def iso_time(value):
    """Interpret an ISO time without an offset in Europe/Stockholm."""
    try:
        result = datetime.fromisoformat(value.replace('Z', '+00:00'))
    except ValueError as error:
        raise argparse.ArgumentTypeError(f'invalid ISO time: {value}') from error
    if result.tzinfo is None:
        result = result.replace(tzinfo=STOCKHOLM)
    return result.astimezone(timezone.utc)


def arguments():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    for name in ('messages', 'usage'):
        command = commands.add_parser(name)
        window = command.add_mutually_exclusive_group()
        window.add_argument('--days', type=float, help='rolling days before now (default: 7)')
        window.add_argument('--since', type=iso_time, help='inclusive ISO time; no offset means Stockholm')
        command.add_argument('--until', type=iso_time, help='exclusive ISO time; requires --since')
    command = commands.add_parser('digest', help='one JSON digest of events and current waiting/late work')
    command.add_argument('--since', type=iso_time, help='inclusive ISO time (default: 24 hours before until)')
    command.add_argument('--until', type=iso_time, help='exclusive ISO time (default: now)')
    args = parser.parse_args()
    if args.command == 'digest':
        until = args.until or datetime.now(timezone.utc)
        since = args.since or until - timedelta(hours=24)
        if since >= until:
            parser.error('--since must be earlier than --until')
        return args.command, (since.isoformat(), until.isoformat())
    if (args.since is None) != (args.until is None):
        parser.error('--since and --until must be used together')
    if args.since is not None:
        since, until = args.since, args.until
    else:
        days = 7 if args.days is None else args.days
        if not math.isfinite(days) or days <= 0:
            parser.error('--days must be a positive finite number')
        until = datetime.now(timezone.utc)
        try:
            since = until - timedelta(days=days)
        except OverflowError:
            parser.error('--days exceeds the supported date range')
    if since >= until:
        parser.error('--since must be earlier than --until')
    return args.command, (since.isoformat(), until.isoformat())


def unwrapped(command):
    """`command` with each `zsh -lc '<script>'` wrapper (Codex's form) replaced by
    the script it runs; the command itself when it does not parse."""
    try:
        argv = shlex.split(command)
    except ValueError:
        return command
    if not any(Path(word).name in SHELLS for word in argv):
        return command
    parts, i = [], 0
    while i < len(argv):
        word = argv[i]
        if (Path(word).name in SHELLS and i + 2 < len(argv)
                and argv[i + 1] in SHELL_SCRIPT_FLAGS):
            parts.append(argv[i + 2])
            i += 3
            # Skip the `$0` and positional arguments given to the script.
            while i < len(argv) and argv[i] not in OPERATORS:
                i += 1
        else:
            parts.append(word if word in OPERATORS else shlex.quote(word))
            i += 1
    return ' '.join(parts)


def without_heredoc_bodies(script):
    """`script` without the bodies of its heredocs; the opener line, and any
    command after the redirection on it, stays."""
    lines, kept, delimiters = script.split('\n'), [], []
    for line in lines:
        if delimiters:
            if line.strip() == delimiters[0]:
                delimiters.pop(0)
            continue
        kept.append(line)
        delimiters = [match.group(2) for match in HEREDOC.finditer(line) if match.group(2)]
    return '\n'.join(kept)


def executable(script):
    """`script` without comments, heredoc bodies and quoted text, so text a
    command only prints or writes is not counted as a command it runs. Command
    substitutions inside double quotes still run, so they stay."""
    script = without_heredoc_bodies(script)
    out, i, n = [], 0, len(script)
    while i < n:
        char = script[i]
        if char == '\\':
            out.append(script[i:i + 2])
            i += 2
        elif char == '#' and (i == 0 or script[i - 1] in ' \t\n;&|('):
            end = script.find('\n', i)
            i = n if end < 0 else end
        elif char == "'":
            end = script.find("'", i + 1)
            if end < 0:
                break  # unterminated: the rest is not a command
            out.append("''")
            i = end + 1
        elif char == '"':
            j = i + 1
            while j < n and script[j] != '"':
                j += 2 if script[j] == '\\' else 1
            out.append(' ; '.join(SUBSTITUTION.findall(script[i + 1:j])) or "''")
            i = j + 1
        else:
            out.append(char)
            i += 1
    return ''.join(out)


def simple_commands(line):
    """The words of each simple command on one shell line, comments dropped.
    A line the shell lexer cannot split (an unclosed quote) yields nothing."""
    lexer = shlex.shlex(line, posix=True, punctuation_chars=True)
    lexer.whitespace_split = True
    try:
        tokens = list(lexer)
    except ValueError:
        return
    words = []
    for token in tokens:
        if token in SHELL_OPERATORS:
            if words:
                yield words
            words = []
        else:
            words.append(token)
    if words:
        yield words


def skills_read(script):
    """Skills whose SKILL.md a reader command in `script` opens. A reader that
    writes (`cat > SKILL.md`) or appears only as quoted text does not count."""
    found = set()
    for line in without_heredoc_bodies(script).splitlines():
        for words in simple_commands(line):
            writes = any(word.startswith('>') and (i == 0 or words[i - 1] != '2')
                         for i, word in enumerate(words))
            if Path(words[0]).name not in SKILL_READERS or writes:
                continue
            found.update(name for word in words[1:] for name in SKILL_FILE.findall(word))
    return found


def messages(db, window):
    query = f"""
        SELECT m.created_at, m.thread_id, t.title, p.title,
               json_extract(m.payload_json, '$.text'),
               (SELECT substr(json_extract(a.payload_json, '$.text'), -700)
                  FROM orchestration_v2_projection_messages AS a
                 WHERE a.thread_id = m.thread_id AND a.role = 'assistant'
                   AND a.created_at < m.created_at
                   AND trim(coalesce(json_extract(a.payload_json, '$.text'), ''),
                            char(9) || char(10) || char(13) || ' ') <> ''
                 ORDER BY a.created_at DESC, a.message_id DESC LIMIT 1)
          FROM orchestration_v2_projection_messages AS m
          LEFT JOIN orchestration_v2_projection_threads AS t ON t.thread_id = m.thread_id
          LEFT JOIN projection_projects AS p ON p.project_id = t.project_id
         WHERE m.message_id IN (
               SELECT message_id FROM orchestration_v2_projection_messages
                WHERE {HUMAN} AND {MESSAGE_WINDOW})
         ORDER BY m.created_at, m.message_id
    """
    for ts, thread_id, title, project, text, tail in db.execute(query, window):
        yield {
            'ts': iso_time(ts).astimezone(STOCKHOLM).isoformat(timespec='minutes'),
            'thread_id': thread_id,
            'thread_title': title,
            'project_title': project,
            'text': text,
            'prev_agent_tail': tail or '',
        }


def usage(db, window):
    # A scheduler dispatch carries its schedule's id; a delegated child's brief
    # lands in a `thread:delegated-task:` thread. Other agent-sent prompts are
    # coordination between threads.
    message_count, thread_count, wakes, heartbeats, briefs, coordination = db.execute(f"""
        SELECT count(*) FILTER (WHERE {HUMAN}),
               count(DISTINCT thread_id) FILTER (WHERE {HUMAN}),
               count(*) FILTER (WHERE scheduled IS NOT NULL),
               count(*) FILTER (WHERE scheduled IS NOT NULL AND (instr(lower(scheduled), 'heartbeat') > 0
                   OR instr(lower(json_extract(payload_json, '$.text')), 'heartbeat') > 0)),
               count(*) FILTER (WHERE agent AND scheduled IS NULL
                   AND thread_id LIKE 'thread:delegated-task:%'),
               count(*) FILTER (WHERE agent AND scheduled IS NULL
                   AND thread_id NOT LIKE 'thread:delegated-task:%')
          FROM (SELECT *, json_extract(payload_json, '$.scheduledTaskId') AS scheduled,
                       role = 'user' AND json_extract(payload_json, '$.createdBy') = 'agent'
                           AND json_extract(payload_json, '$.creationSource') = 'mcp' AS agent
                  FROM orchestration_v2_projection_messages WHERE {MESSAGE_WINDOW})
    """, window).fetchone()
    tools = Counter()
    skills = {'claude': Counter(), 'codex': Counter()}
    questions = 0
    shell = dict.fromkeys(COMMAND_PATTERNS, 0)
    rows = db.execute(f"""
        SELECT i.type, json_extract(i.payload_json, '$.toolName'),
               json_extract(i.payload_json, '$.input.skill'),
               CASE WHEN json_type(i.payload_json, '$.input') = 'text'
                    THEN json_extract(i.payload_json, '$.input')
                    ELSE json_extract(i.payload_json, '$.input.command') END,
               t.default_provider, i.status
          FROM orchestration_v2_projection_turn_items AS i
          LEFT JOIN orchestration_v2_projection_threads AS t ON t.thread_id = i.thread_id
         WHERE i.type IN ('dynamic_tool', 'command_execution', 'user_input_request')
           AND julianday(i.updated_at) >= julianday(?) AND julianday(i.updated_at) < julianday(?)
    """, window)
    for kind, name, skill, command, provider, status in rows:
        if kind == 'dynamic_tool':
            if isinstance(name, str):
                for prefix in TOOL_PREFIXES:
                    if name.startswith(prefix):
                        tools[name.removeprefix(prefix)] += 1
                        break
            if name == 'Skill' and isinstance(skill, str) and skill:
                skills['claude'][skill] += 1
        elif kind == 'user_input_request':
            questions += 1
        elif isinstance(command, str):
            script = unwrapped(command)
            if provider == 'codex' and status == 'completed':
                # Codex loads a skill by reading its file.
                for name in skills_read(script):
                    skills['codex'][name] += 1
            script = executable(script)
            for category, pattern in COMMAND_PATTERNS.items():
                shell[category] += bool(re.search(pattern, script))
    since, until = (iso_time(bound).astimezone(STOCKHOLM).isoformat(timespec='seconds') for bound in window)
    return {
        # Stockholm time with its offset: a rolling week can span a DST change.
        'window': {'since': since, 'until': until},
        'sebastian_messages': message_count,
        'threads_with_messages': thread_count,
        'scheduled_wakes': wakes,
        'heartbeat_wakes': heartbeats,
        'delegated_briefs': briefs,
        'agent_coordination_messages': coordination,
        't3_tool_calls': dict(sorted(tools.items())),
        'skill_loads': {runtime: dict(sorted(counts.items())) for runtime, counts in skills.items()},
        'user_input_requests': questions,
        'shell_commands': shell,
    }


def digest_text(value, opaque=True):
    """Redact credentials in human-authored fields before they leave local state.

    Only selected fields reach the digest; no messages, answers, commands, run
    errors or task results are read. Opaque token-like words are redacted too.
    """
    text = str(value or '')
    text = re.sub(r'-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?(?:-----END [^-]*PRIVATE KEY-----|$)',
                  '[REDACTED]', text)
    text = re.sub(r'(?i)\b(?:https?|postgres(?:ql)?|redis)://[^\s/@]+:[^\s/@]+@',
                  '[REDACTED]@', text)
    text = re.sub(r'(?i)\b(?:bearer\s+|[\w-]*(?:password|passwd|secret|token|api[_ -]?key|'
                  r'access[_ -]?key|authorization)[\w-]*[\'"]?\s*[=:]\s*)'
                  r'(?:"[^"\n]*"|\x27[^\x27\n]*\x27|[^\s,;\x60\'"]+)',
                  '[REDACTED]', text)
    text = re.sub(r'\b(?:sk-|gh[pousr]_|github_pat_|xox[baprs]-|AKIA|ASIA)[\w-]+',
                  '[REDACTED]', text)
    text = re.sub(r'\beyJ[\w-]+(?:\.[\w-]+){1,2}', '[REDACTED]', text)
    # Credential-like strings, including hex keys. UUIDs and ordinary paths
    # remain usable; long mixed-case/digit strings and hex blobs do not.
    if opaque:
        text = re.sub(r'\b[0-9a-fA-F]{32,}\b', '[REDACTED]', text)
        text = re.sub(r'(?<![\w-])(?=[\w+=-]{24,}(?![\w-]))'
                      r'(?=[\w+=-]*[A-Z])(?=[\w+=-]*[a-z])(?=[\w+=-]*\d)'
                      r'[\w+=-]{24,}', '[REDACTED]', text)
    return text


def digest_time(value):
    return iso_time(value).astimezone(STOCKHOLM).isoformat(timespec='seconds')


def github_pull_request(url):
    """The pull request's live state, title and merge time from GitHub, or None."""
    try:
        result = subprocess.run(['gh', 'pr', 'view', url, '--json', 'state,isDraft,mergedAt,title'],
                                capture_output=True, text=True, timeout=20, check=False)
        return json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def github_merged(since):
    """Pull requests by the account `gh` uses (the agents') merged since `since`, or None."""
    stamp = since.astimezone(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')
    try:
        result = subprocess.run(['gh', 'search', 'prs', '--author', '@me', '--merged-at', f'>={stamp}',
                                 '--json', 'url,title,closedAt', '--limit', '200'],
                                capture_output=True, text=True, timeout=30, check=False)
        return json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def digest_tasks(db, row, gate):
    """The effort-gate t3_task_ended lookup, using our existing read transaction.

    Reuse its handle tokenizer, prefix and ended states. The SQL and treatment
    of unknown handles deliberately match t3_task_ended (which opens its own DB).
    """
    tasks = []
    for word in sorted(set(gate['T3_HANDLE_WORD'].findall(row.get('handle', '')))):
        if word.startswith(gate['T3_TASK_ID']):
            found = db.execute('SELECT subagent_id, status FROM orchestration_v2_projection_subagents '
                               'WHERE subagent_id = ?', (word,)).fetchone()
        else:
            suffix = 'delegate-task' + quote(':' + word, safe="!*'()")
            found = db.execute(
                'SELECT subagent_id, status FROM orchestration_v2_projection_subagents '
                'WHERE substr(subagent_id, -length(?)) = ? ORDER BY started_at DESC LIMIT 1',
                (suffix, suffix)).fetchone()
        if found:
            tasks.append({'task_id': found[0], 'status': found[1]})
    return tasks if tasks and all(task['status'] in gate['T3_ENDED'] for task in tasks) else []


def digest_efforts(projects, errors):
    """Discover each physical effort once, including linked git worktrees."""
    roots = {}
    for project_id, title, workspace in projects:
        root = Path(workspace).expanduser().resolve()
        roots.setdefault(root, (project_id, title))
        if not root.is_dir():
            errors.append({'path': str(root), 'operation': 'discover_efforts', 'error': 'workspace unavailable'})
            continue
        try:
            result = subprocess.run(['git', '-C', str(root), 'worktree', 'list', '--porcelain', '-z'],
                                    capture_output=True, text=True, timeout=3, check=False)
            # A non-repository workspace is still scanned; it has no worktrees.
            if result.returncode == 0:
                for field in result.stdout.split('\0'):
                    if field.startswith('worktree '):
                        roots.setdefault(Path(field[9:]).resolve(), (project_id, title))
            elif (root / '.git').exists():
                errors.append({'path': str(root), 'operation': 'list_worktrees', 'error': 'git failed'})
        except (OSError, subprocess.TimeoutExpired) as error:
            errors.append({'path': str(root), 'operation': 'list_worktrees', 'error': type(error).__name__})
    seen = set()
    for root, (project_id, title) in sorted(roots.items()):
        try:
            # Explicit iteration reports permission failures that glob may hide.
            scratch = root / '.scratch'
            if not scratch.exists():
                continue
            for directory in sorted(scratch.iterdir()):
                path = directory / 'effort.md'
                if not directory.is_dir() or (not path.exists() and not path.is_symlink()):
                    continue
                resolved = path.resolve()
                if resolved in seen:
                    continue
                seen.add(resolved)
                try:
                    text = path.read_text()
                    modified = datetime.fromtimestamp(path.stat().st_mtime, timezone.utc)
                except (OSError, UnicodeError) as error:
                    errors.append({'effort_path': str(path), 'operation': 'read_effort',
                                   'error': type(error).__name__})
                    continue
                yield path, root, project_id, title, text, modified
        except OSError as error:
            errors.append({'path': str(root), 'operation': 'discover_efforts', 'error': type(error).__name__})


def digest(db, window):
    """Windowed landed/failed events plus current waiting, late and running state.

    Current state is observed now, even for an explicitly historical window;
    age/staleness use that observation time, never the window's upper bound.
    """
    now = datetime.now(timezone.utc)
    since, until = map(iso_time, window)
    result = {'window': dict(zip(('since', 'until'), map(digest_time, window))),
              'state_observed_at': now.astimezone(STOCKHOLM).isoformat(timespec='seconds'),
              'landed': [], 'waiting_on_sebastian': [], 'late': [],
              'running': {'active_efforts': 0, 'threads_with_active_run': 0}, 'errors': []}
    errors = result['errors']

    def payload(raw, source):
        try:
            value = json.loads(raw or '{}')
            if not isinstance(value, dict):
                raise ValueError('not an object')
            return value
        except ValueError:
            errors.append({**source, 'error': 'invalid JSON object'})
            return {}

    def parsed_time(value, source):
        try:
            return iso_time(value)
        except (argparse.ArgumentTypeError, AttributeError, TypeError):
            errors.append({**source, 'error': 'invalid timestamp'})
            return None

    projects = list(db.execute('SELECT project_id, title, workspace_root FROM projection_projects '
                               'WHERE deleted_at IS NULL ORDER BY project_id'))
    project_titles = {pid: title for pid, title, _ in projects}
    threads = {}
    for tid, title, pid, archived, raw in db.execute(
            'SELECT thread_id, title, project_id, archived_at, payload_json '
            'FROM orchestration_v2_projection_threads WHERE deleted_at IS NULL ORDER BY thread_id'):
        threads[tid] = {'thread_id': tid, 'thread_title': title, 'project_id': pid,
                        'project_title': project_titles.get(pid), 'archived': bool(archived),
                        'payload': payload(raw, {'thread_id': tid})}

    def thread_fields(tid):
        return {key: value for key, value in threads[tid].items() if key != 'payload'}

    active_threads = set()
    ended_runs = {'completed', 'failed', 'cancelled', 'interrupted'}
    def resent_in(tid, requested):
        """A later thread that opens with this thread's first message: Sebastian
        resent the request (often to another project), so nothing was lost."""
        first = db.execute("SELECT json_extract(payload_json, '$.text') FROM orchestration_v2_projection_turn_items "
                           "WHERE thread_id = ? AND type = 'user_message' ORDER BY ordinal LIMIT 1", (tid,)).fetchone()
        if not first or not first[0]:
            return None
        found = db.execute(
            "SELECT i.thread_id FROM orchestration_v2_projection_turn_items i "
            "JOIN orchestration_v2_projection_runs r ON r.thread_id = i.thread_id "
            "WHERE i.type = 'user_message' AND i.thread_id != ? AND json_extract(i.payload_json, '$.text') = ? "
            "AND julianday(r.requested_at) >= julianday(?) ORDER BY r.requested_at LIMIT 1",
            (tid, first[0], requested)).fetchone()
        return found[0] if found else None

    for rid, tid, status, requested, completed in db.execute(
            'SELECT run_id, thread_id, status, requested_at, completed_at FROM orchestration_v2_projection_runs '
            'ORDER BY requested_at, run_id'):
        if tid not in threads:
            continue
        if status not in ended_runs and completed is None:
            active_threads.add(tid)
        if status == 'failed':
            finished = parsed_time(completed, {'thread_id': tid, 'run_id': rid})
            if finished is not None and since <= finished < until:
                resent = resent_in(tid, requested)
                result['late'].append({'type': 'failed_run', **thread_fields(tid), 'run_id': rid,
                                       'completed_at': digest_time(completed),
                                       'resent_in_thread_id': resent})
    result['running']['threads_with_active_run'] = len(active_threads)

    for request_id, tid, node_id, kind, created, raw in db.execute(
            "SELECT runtime_request_id, thread_id, node_id, kind, created_at, payload_json "
            "FROM orchestration_v2_projection_runtime_requests WHERE status = 'pending' "
            'ORDER BY created_at, runtime_request_id'):
        if tid not in threads:
            continue
        source = {'thread_id': tid, 'request_id': request_id}
        request = payload(raw, source)
        questions = []

        recommended = []

        def question_texts(item):
            if isinstance(item.get('question'), str):
                questions.append(item['question'])
            for question in item.get('questions', []) or []:
                if isinstance(question, dict) and isinstance(question.get('question'), str):
                    questions.append(question['question'])
                    # The agent's recommendation, when it marked an option.
                    recommended.extend(option['label'] for option in question.get('options') or []
                                       if isinstance(option, dict) and isinstance(option.get('label'), str)
                                       and 'recommend' in option['label'].lower())

        question_texts(request)
        for (item_raw,) in db.execute(
                "SELECT payload_json FROM orchestration_v2_projection_turn_items "
                "WHERE node_id = ? AND thread_id = ? AND type = 'user_input_request' ORDER BY ordinal",
                (node_id, tid)):
            question_texts(payload(item_raw, source))
        created_time = parsed_time(created, source)
        result['waiting_on_sebastian'].append({
            'type': 'runtime_request', **thread_fields(tid), 'request_id': request_id, 'kind': kind,
            'created_at': digest_time(created) if created_time else None,
            'age_seconds': max(0, int((now - created_time).total_seconds())) if created_time else None,
            'questions': list(dict.fromkeys(questions)),
            'recommended_options': list(dict.fromkeys(recommended))})

    for tid, url, raw in db.execute(
            'SELECT thread_id, url, snapshot_json FROM projection_thread_pull_requests ORDER BY url, thread_id'):
        if tid not in threads or not raw:
            continue
        pr = payload(raw, {'thread_id': tid, 'url': url})
        state_source = 'snapshot'
        if str(pr.get('state', '')).lower() == 'open':
            # T3 stops refreshing a pull request once its thread goes quiet, so
            # an open snapshot is often days old; GitHub has the current state.
            live = github_pull_request(url)
            if live is None:
                errors.append({'thread_id': tid, 'url': url, 'operation': 'refresh_pull_request',
                               'error': 'gh pr view failed; using the T3 snapshot'})
            else:
                pr, state_source = {**pr, **live}, 'github'
        fields = {'type': 'pull_request', **thread_fields(tid), 'url': url,
                  'pr_title': pr.get('title'), 'state_source': state_source,
                  'snapshot_synced_at': pr.get('syncedAt')}
        if str(pr.get('state', '')).lower() == 'merged':
            merged = parsed_time(pr.get('mergedAt'), {'thread_id': tid, 'url': url})
            if merged is not None and since <= merged < until:
                result['landed'].append({**fields, 'merged_at': digest_time(pr['mergedAt'])})
        elif (str(pr.get('state', '')).lower() == 'open' and pr.get('isDraft') is False
              and tid not in active_threads
              and threads[tid]['payload'].get('status') != 'running'):
            result['waiting_on_sebastian'].append({**fields, 'reason': 'open_non_draft_pr_thread_not_running'})

    # Most agent pull requests are never linked to a T3 thread; GitHub has them all.
    merged = github_merged(since)
    if merged is None:
        errors.append({'operation': 'search_merged_pull_requests', 'error': 'gh search prs failed'})
    linked = {entry.get('url') for entry in result['landed'] if entry['type'] == 'pull_request'}
    for pr in merged or []:
        finished = parsed_time(pr.get('closedAt'), {'url': pr.get('url'), 'operation': 'search_merged_pull_requests'})
        if pr.get('url') not in linked and finished is not None and since <= finished < until:
            result['landed'].append({'type': 'pull_request', 'url': pr['url'], 'pr_title': pr.get('title'),
                                     'merged_at': digest_time(pr['closedAt']), 'state_source': 'github_search'})

    # Reuse the gate's front matter and tables, including its definition of an
    # open item and escaped Markdown pipes; loading it does not run its CLI.
    gate = runpy.run_path(str(Path(__file__).resolve().with_name('effort-gate')))
    for path, root, pid, project, text, modified in digest_efforts(projects, errors):
        front = gate['front_matter'](text)
        checkout = front.get('checkout')
        if checkout and Path(checkout).expanduser().resolve() != root:
            continue  # copied effort, owned by a different checkout (as in effort-gate)
        status = front.get('status', '').strip('`* ').lower()
        heading = re.search(r'^# (.+)$', text, re.MULTILINE)
        fields = {'type': 'effort', 'effort_path': str(path), 'effort_title': heading[1] if heading else path.parent.name,
                  'project_id': pid, 'project_title': project, 'session': front.get('session'),
                  'status': status, 'modified_at': modified.astimezone(STOCKHOLM).isoformat(timespec='seconds')}
        if status == 'done' and since <= modified < until:
            # mtime is a completion proxy: editing an already-done effort can
            # report it again; there is no status-transition history on disk.
            result['landed'].append({**fields, 'completion_signal': 'file_mtime'})
        section = re.search(r'^## Blockers\s*\n(.*?)(?=^## |\Z)', text, re.MULTILINE | re.DOTALL)
        blockers = section[1].strip() if section else ''
        blocked_items = [f"#{row.get('#', '?')} {row.get('item', '').strip()}"
                         for row in gate['table'](text, 'done when')
                         if row.get('status', '').strip('`* ').lower() == 'blocked']
        # An active effort can wait on Sebastian too: its blocked items stay
        # out of the gate's open items, so only its Blockers section shows it.
        if status == 'blocked' or (status == 'active' and (
                blocked_items or (blockers and blockers.rstrip('.').lower() != 'none'))):
            result['waiting_on_sebastian'].append({**fields, 'blockers': blockers,
                                                   'blockers_section_present': bool(section),
                                                   'blocked_items': blocked_items})
        if status == 'active':
            result['running']['active_efforts'] += 1
            items = gate['open_items'](text)
            age = (now - modified).total_seconds()
            if items and age > 6 * 3600:
                result['late'].append({**fields, 'type': 'stalled_effort', 'unchanged_seconds': int(age),
                                       'open_items': items})
        for row in gate['table'](text, 'milestones'):
            if row.get('state', row.get('status', '')).strip('`* ').lower() != 'open':
                continue
            due = row.get('due (stockholm)', row.get('due', '')).strip('` ')
            due_time = parsed_time(due, {'effort_path': str(path), 'operation': 'parse_milestone_due'})
            if due_time is not None and due_time < now:
                result['late'].append({**fields, 'type': 'overdue_milestone',
                                       'milestone': row.get('milestone', ''), 'due': digest_time(due),
                                       'overdue_seconds': int((now - due_time).total_seconds())})
        for row in gate['running_rows'](text):
            if gate['T3_OWNED'].search(gate['row_runtime'](row)):
                tasks = digest_tasks(db, row, gate)
                if tasks:
                    result['late'].append({**fields, 'type': 'ended_task_still_running',
                                           'task': row.get('task', '?'), 'handle': row.get('handle', ''),
                                           'ended_tasks': tasks})

    def redacted(value, key=None):
        if isinstance(value, dict):
            return {name: redacted(item, name) for name, item in value.items()}
        if isinstance(value, list):
            return [redacted(item, key) for item in value]
        # T3's structural IDs contain long percent-encoded words that resemble
        # opaque credentials; preserve those links, while still filtering known
        # credential forms. Free text (including handles) gets both checks.
        identity = key in {'thread_id', 'project_id', 'request_id', 'run_id', 'task_id', 'session',
                            'resent_in_thread_id'}
        return digest_text(value, opaque=not identity) if isinstance(value, str) else value

    return redacted(result)


def main():
    command, window = arguments()
    try:
        with closing(sqlite3.connect(DATABASE.as_uri() + '?mode=ro', uri=True)) as db:
            # One read transaction keeps every query on the same live snapshot.
            db.execute('BEGIN')
            if command == 'messages':
                records = messages(db, window)
            else:
                records = ((digest if command == 'digest' else usage)(db, window),)
            for record in records:
                print(json.dumps(record, ensure_ascii=False))
    except (sqlite3.Error, OSError) as error:
        print(f'agent-messages: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
