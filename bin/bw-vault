#!/bin/bash
# Run Bitwarden CLI at the version compatible with WL7R's Vaultwarden API.
#
# CLI 2026.11.0 was verified against Vaultwarden 1.37.5 (API 2026.6.0) for
# login, API-key login, unlock, sync and list on 21 Nov 2026. Older CLIs
# failed against older servers (`RangeError: Invalid time value`), so keep
# bridge and agent operations on one reviewed version and reverify the
# server/client pair together on every change.
set -euo pipefail
set +x

# Use the session bw-bridge cached, unless the caller passes one (bridge
# verification does): Linux reads the expiring runtime cache, macOS the Login
# Keychain until the expiry bw-bridge recorded beside it.
if [[ ! ${BW_SESSION+x} ]]; then
	BW_SESSION=
	case $(uname -s) in
	Linux)
		cache=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/bw-session-cache
		BW_SESSION=$("$cache" read 2>/dev/null) || BW_SESSION=
		;;
	Darwin)
		expires=$(cat "${XDG_STATE_HOME:-$HOME/.local/state}/bw-bridge/expires-at" 2>/dev/null) || expires=
		if [[ $expires =~ ^[0-9]{1,12}$ ]] && (($(date +%s) < 10#$expires)); then
			BW_SESSION=$(/usr/bin/security find-generic-password -a "$USER" \
				-s personal-infra-bitwarden-session -w 2>/dev/null) || BW_SESSION=
		fi
		;;
	esac
	export BW_SESSION
fi

readonly CLI_VERSION=2026.11.0

exec npx --yes --package="@bitwarden/cli@${CLI_VERSION}" -- bw "$@"
