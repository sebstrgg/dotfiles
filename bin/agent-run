#!/usr/bin/env python3
"""Run a Codex or Claude agent detached, with model, effort and access pinned.

  agent-run start <codex|claude> <role> <run-dir> [--model M] [--effort E]
      Run the agent on <run-dir>/prompt.md in the current directory, in its own
      process session, and return at once.
  agent-run resume <run-dir> <new-run-dir>
      Resume the finished or stopped run's agent session with
      <new-run-dir>/prompt.md as the next message, keeping its runtime, role,
      model, effort and access.
  agent-run wait <run-dir> [--quiet-minutes N]
      Block until that run exits, print its session handle and last message,
      and exit with its exit code. A run that writes nothing to its folder for
      N minutes (default 30) ends the wait with exit 124 while the run goes
      on, so a stuck agent wakes whoever waits instead of holding them.

The role decides access:
  work      a lane that builds and commits: full access
  continue  a continuation that owns the effort: full access, and it may
            reach the other model family for its own verify and review
  verify    a fresh `verify` run on the real target: full access, because
            checks reach live services; reports only
  review    a code review: Codex in its read-only sandbox; reports only

Defaults: Codex `gpt-6.1-sol` at `high` (`xhigh` for review), Claude `opus` at
`high`. Codex runs other than `continue` start signed out of Claude, so only
the orchestrator spends Claude usage. Claude runs keep Sebastian's configured
permission mode; verify and review runs have no edit tools.

Runs other than `continue` carry AGENT_RUN_ROLE=<role>: they work their brief
for the orchestrator, so `effort-gate` neither gates them nor lets them create
or claim an effort file, and `agent-run` refuses to start or resume a run from
one.

A provider refusal (model at capacity, overloaded, a 5xx or 429) resumes the
same session after 30 s, 2 min and 5 min; any other failure ends the run.

The run folder receives command.json (what ran, for the record), events.jsonl,
stderr.log, last.md and, when the agent exits, `exit` holding its exit code.
"""
import argparse
import contextlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

ROLES = ('work', 'continue', 'verify', 'review')
QUIET_EXIT = 124
CLAUDE_CREDENTIALS = ('ANTHROPIC_API_KEY', 'ANTHROPIC_AUTH_TOKEN', 'CLAUDE_CODE_OAUTH_TOKEN')
MODELS = {'codex': 'gpt-6.1-sol', 'claude': 'opus'}
REPORT_ONLY = {'verify', 'review'}
# Provider refusals that a later attempt can pass: the same delays as the
# reviewer runner. Anything else is the agent's own failure and is not retried.
RETRY_DELAYS = '30,120,300'
REFUSAL = re.compile(r'at capacity|overloaded|\b(?:429|500|502|503|504|529)\b', re.IGNORECASE)
RETRY_PROMPT = ('Your previous turn ended because the model provider refused it (at capacity or '
                'overloaded). Continue your brief from where you stopped; do not repeat finished '
                'steps.\n')


def default_effort(runtime, role):
    return 'xhigh' if runtime == 'codex' and role == 'review' else 'high'


def command(runtime, role, model, effort, run_dir, session=None):
    """The agent's command line; `session` resumes that agent session."""
    if runtime == 'codex':
        sandbox = 'read-only' if role == 'review' else 'danger-full-access'
        pins = ['--json', '-m', model, '-c', f'model_reasoning_effort={effort}']
        last = ['-o', str(run_dir / 'last.md')]
        if session:
            # `exec resume` takes no -s; the sandbox goes in as configuration.
            return ['codex', 'exec', 'resume', *pins, '-c', f'sandbox_mode={sandbox}', *last,
                    session, '-']
        return ['codex', 'exec', *pins, '-s', sandbox, *last, '-']
    argv = ['claude', '-p', '--model', model, '--effort', effort,
            '--output-format', 'stream-json', '--verbose']
    if session:
        argv += ['--resume', session]
    if role in REPORT_ONLY:
        argv += ['--disallowedTools', 'Edit', 'Write', 'NotebookEdit']
    return argv


def environment(runtime, role, run_dir):
    env = dict(os.environ)
    if role == 'continue':
        env.pop('AGENT_RUN_ROLE', None)
    else:
        env['AGENT_RUN_ROLE'] = role
    if runtime == 'codex' and role != 'continue':
        signed_out = run_dir / 'claude-signed-out'
        signed_out.mkdir(exist_ok=True)
        env['CLAUDE_CONFIG_DIR'] = str(signed_out)
        for name in CLAUDE_CREDENTIALS:
            env.pop(name, None)
    return env


def refuse_delegated():
    if os.environ.get('AGENT_RUN_ROLE'):
        sys.exit(f'agent-run: this is a delegated {os.environ["AGENT_RUN_ROLE"]} run '
                 '(AGENT_RUN_ROLE). Further runs are the orchestrator\'s decision: name what '
                 'you need in your report.')


def prompted(run_dir):
    run_dir = Path(run_dir).expanduser().resolve()
    if not (run_dir / 'prompt.md').is_file():
        sys.exit(f'agent-run: {run_dir / "prompt.md"} is missing; write the prompt there first')
    return run_dir


def start(args):
    refuse_delegated()
    run_dir = prompted(args.run_dir)
    model = args.model or MODELS[args.runtime]
    effort = args.effort or default_effort(args.runtime, args.role)
    return launch(run_dir, {'runtime': args.runtime, 'role': args.role, 'model': model,
                            'effort': effort, 'cwd': os.getcwd()})


def resume(args):
    refuse_delegated()
    earlier = Path(args.run_dir).expanduser().resolve()
    try:
        record = json.loads((earlier / 'command.json').read_text())
    except (OSError, ValueError):
        sys.exit(f'agent-run: {earlier} has no run record')
    if not (earlier / 'exit').exists():
        sys.exit(f'agent-run: the run in {earlier} is still running; wait for it or stop it first')
    session = session_id(earlier / 'events.jsonl')
    if session is None:
        sys.exit(f'agent-run: {earlier} recorded no session to resume')
    run_dir = prompted(args.new_run_dir)
    fields = {key: record[key] for key in ('runtime', 'role', 'model', 'effort', 'cwd')}
    return launch(run_dir, {**fields, 'resumes': str(earlier)}, session)


def launch(run_dir, record, session=None):
    """Record the run in <run_dir>/command.json and start its supervisor detached."""
    runtime, role = record['runtime'], record['role']
    argv = command(runtime, role, record['model'], record['effort'], run_dir, session)
    if shutil.which(argv[0]) is None:
        sys.exit(f'agent-run: {argv[0]} is not on PATH')
    record = {**record, 'argv': argv, 'started': time.strftime('%Y-%m-%dT%H:%M:%S%z')}
    try:
        with (run_dir / 'command.json').open('x') as claimed:
            claimed.write(json.dumps(record, indent=2) + '\n')
    except FileExistsError:
        sys.exit(f'agent-run: {run_dir} was already used by a run; give each run its own folder')
    supervisor = subprocess.Popen(
        [sys.executable, str(Path(__file__).resolve()), '_supervise', str(run_dir)],
        env=environment(runtime, role, run_dir), start_new_session=True,
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    (run_dir / 'pid').write_text(f'{supervisor.pid}\n')
    verb = 'Resumed' if session else 'Started'
    print(f'{verb} {runtime} {role} ({record["model"]}, {record["effort"]}) in {run_dir}.\n'
          f'Wait with: {Path(__file__).resolve()} wait {run_dir}')
    return 0


def supervise(run_dir):
    """Run the agent with the prompt on stdin, then write last.md and the exit marker.
    A provider refusal (model at capacity, overloaded) resumes the same session
    after each delay in RETRY_DELAYS; any other failure ends the run at once.
    A signal that stops this supervisor is passed on to the agent's process group,
    so stopping the recorded pid stops the run and still leaves an exit marker."""
    record = json.loads((run_dir / 'command.json').read_text())
    code = 127
    agent = None
    stopped = False

    def pass_on(received, _frame):
        nonlocal stopped
        stopped = True
        if agent is not None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(agent.pid, received)

    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(signum, pass_on)
    delays = [float(d) for d in os.environ.get('AGENT_RUN_RETRY_DELAYS', RETRY_DELAYS).split(',')]
    try:
        argv, prompt, mode = record['argv'], (run_dir / 'prompt.md').read_text(), 'w'
        while True:
            attempt_start = (run_dir / 'events.jsonl').stat().st_size if mode == 'a' else 0
            with ((run_dir / 'events.jsonl').open(mode) as stdout,
                  (run_dir / 'stderr.log').open(mode) as stderr):
                agent = subprocess.Popen(argv, cwd=record['cwd'], stdin=subprocess.PIPE,
                                         stdout=stdout, stderr=stderr, process_group=0, text=True)
                agent.communicate(prompt)
                code = agent.returncode
                code = 128 - code if code < 0 else code
            session = session_id(run_dir / 'events.jsonl')
            if code == 0 or stopped or not delays or session is None \
                    or not refused(run_dir / 'events.jsonl', attempt_start):
                break
            resume_at = time.monotonic() + delays.pop(0)
            while not stopped and time.monotonic() < resume_at:
                time.sleep(min(1, max(0, resume_at - time.monotonic())))
            if stopped:
                break
            argv = command(record['runtime'], record['role'], record['model'], record['effort'],
                           run_dir, session)
            prompt, mode = RETRY_PROMPT, 'a'
        if record['runtime'] == 'claude':
            result = claude_result(run_dir / 'events.jsonl')
            if result is not None:
                (run_dir / 'last.md').write_text(result.rstrip('\n') + '\n')
    finally:
        marker = run_dir / 'exit.tmp'
        marker.write_text(f'{code}\n')
        marker.replace(run_dir / 'exit')
    return 0


def events(path, start=0):
    try:
        with path.open('rb') as log:
            log.seek(start)
            lines = log.read().decode(errors='replace').splitlines()
    except OSError:
        return
    for line in lines:
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if isinstance(event, dict):
            yield event


def refused(path, start=0):
    """Whether the attempt logged from byte `start` ended on a provider refusal."""
    message = None
    for event in events(path, start):
        if event.get('type') in ('error', 'turn.failed'):
            error = event.get('error')
            message = error.get('message') if isinstance(error, dict) else event.get('message')
        elif event.get('type') == 'result':
            message = event.get('result') if event.get('is_error') else None
    return isinstance(message, str) and REFUSAL.search(message) is not None


def claude_result(path):
    results = [event.get('result') for event in events(path) if event.get('type') == 'result']
    return results[-1] if results and isinstance(results[-1], str) else None


def session_id(path):
    """The Codex thread or Claude session a run's events record, or None."""
    for event in events(path):
        if event.get('thread_id') or event.get('session_id'):
            return event.get('thread_id') or event.get('session_id')
    return None


def session_handle(path):
    for event in events(path):
        if event.get('thread_id'):
            return f'Codex thread {event["thread_id"]} (agent-run resume <run-dir> <new-run-dir>)'
        if event.get('session_id'):
            return f'Claude session {event["session_id"]} (agent-run resume <run-dir> <new-run-dir>)'
    return 'no session handle recorded'


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def last_write(run_dir):
    return max(path.stat().st_mtime for path in run_dir.iterdir() if path.is_file())


def wait(args):
    run_dir = Path(args.run_dir).expanduser().resolve()
    exit_file = run_dir / 'exit'
    try:
        pid = int((run_dir / 'pid').read_text())
    except (OSError, ValueError):
        sys.exit(f'agent-run: {run_dir} has no started run')
    quiet_limit = args.quiet_minutes * 60
    while not exit_file.exists():
        if not alive(pid) and not exit_file.exists():
            sys.exit(f'agent-run: the run in {run_dir} ended without an exit marker; see stderr.log')
        quiet = time.time() - last_write(run_dir)
        if quiet >= quiet_limit:
            print(f'Still running (pid {pid}) but nothing written for {quiet / 60:.0f} minutes. '
                  f'Read the end of events.jsonl and stderr.log: wait again if it is working, '
                  f'stop the pid if it is stuck.')
            return QUIET_EXIT
        time.sleep(2)
    code = int(exit_file.read_text())
    print(f'Exit {code}. {session_handle(run_dir / "events.jsonl")}.')
    last = run_dir / 'last.md'
    if last.exists():
        print(last.read_text().rstrip('\n'))
    else:
        print('No last message. End of stderr.log:')
        print('\n'.join((run_dir / 'stderr.log').read_text().splitlines()[-20:]))
    return code


def main():
    if sys.argv[1:2] == ['_supervise'] and len(sys.argv) == 3:
        return supervise(Path(sys.argv[2]))
    parser = argparse.ArgumentParser(prog='agent-run', description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest='command', required=True)
    started = commands.add_parser('start', help='start a detached run')
    started.add_argument('runtime', choices=sorted(MODELS))
    started.add_argument('role', choices=ROLES)
    started.add_argument('run_dir')
    started.add_argument('--model')
    started.add_argument('--effort')
    resumed = commands.add_parser('resume', help="resume an earlier run's agent session")
    resumed.add_argument('run_dir')
    resumed.add_argument('new_run_dir')
    waited = commands.add_parser('wait', help='wait for a run and print its result')
    waited.add_argument('run_dir')
    waited.add_argument('--quiet-minutes', type=float, default=30,
                        help=f'end the wait with exit {QUIET_EXIT} after this long without output')
    args = parser.parse_args()
    return {'start': start, 'resume': resume, 'wait': wait}[args.command](args)


if __name__ == '__main__':
    sys.exit(main())
