#!/bin/bash
# Interactive Bitwarden unlock; cache a verified session for HOURS (default 12).
# macOS uses Login Keychain; Linux uses the private tmpfs runtime directory.
set -euo pipefail
set +x

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BW_CLI="$SCRIPT_DIR/bw-vault"
SERVICE=personal-infra-bitwarden-session
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/bw-bridge"
EXPIRES_AT="$STATE_DIR/expires-at"
DEFAULT_HOURS=12
PLATFORM=$(uname -s)
if [[ $PLATFORM == Linux ]]; then
	export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
fi

if [[ ! -x "$BW_CLI" ]]; then
	echo "ERROR: compatible Bitwarden wrapper is missing: $BW_CLI" >&2
	exit 1
fi

cached_session() {
	/usr/bin/security find-generic-password -a "$USER" -s "$SERVICE" -w 2>/dev/null
}

expire() {
	local session now
	if [[ $PLATFORM == Linux ]]; then
		if ! "$SCRIPT_DIR/bw-session-cache" read >/dev/null; then
			"$BW_CLI" lock >/dev/null 2>&1 || true
		fi
		return
	fi
	session="$(cached_session)" || {
		rm -f "$EXPIRES_AT"
		return 0
	}
	now=$(date +%s)
	if [[ ! -f "$EXPIRES_AT" ]]; then
		# A session bridged before expiry existed gets the default lifetime.
		mkdir -p "$STATE_DIR"
		echo $((now + DEFAULT_HOURS * 3600)) >"$EXPIRES_AT"
		return 0
	fi
	if ((now < $(<"$EXPIRES_AT"))); then
		return 0
	fi
	BW_SESSION="$session" "$BW_CLI" lock >/dev/null 2>&1 || true
	unset session
	/usr/bin/security delete-generic-password -a "$USER" -s "$SERVICE" >/dev/null 2>&1 || true
	rm -f "$EXPIRES_AT"
	echo "bw-bridge: session expired and closed"
}

if [[ "${1:-}" == expire ]]; then
	expire
	exit 0
fi

hours="${1:-$DEFAULT_HOURS}"
if [[ ! "$hours" =~ ^[1-9][0-9]{0,3}$ ]]; then
	echo "usage: bw-bridge [HOURS] | bw-bridge expire" >&2
	exit 64
fi

[[ -t 0 ]] || {
	echo 'ERROR: unlock from an interactive terminal; automation never unlocks' >&2
	exit 1
}
status="$("$BW_CLI" status | jq -r .status)"
if [[ "$status" == "unauthenticated" ]]; then
	"$BW_CLI" login
fi

session="$("$BW_CLI" unlock --raw)"
check="$(BW_SESSION="$session" "$BW_CLI" status | jq -r .status)"
if [[ "$check" != "unlocked" ]]; then
	echo "ERROR: cached session does not unlock the vault (status: $check)" >&2
	exit 1
fi

expires=$(($(date +%s) + hours * 3600))
if [[ $PLATFORM == Linux ]]; then
	printf '%s\n' "$session" | "$SCRIPT_DIR/bw-session-cache" store "$expires"
	unset session
	# Expiry on reads is authoritative even if the timer or user manager stops.
	systemctl --user stop bw-bridge-expire.timer bw-bridge-expire.service >/dev/null 2>&1 || true
	if ! systemd-run --user --quiet --collect --unit=bw-bridge-expire \
		--on-active="${hours}h" --timer-property=AccuracySec=1s "$SCRIPT_DIR/bw-bridge" expire; then
		"$SCRIPT_DIR/bw-session-cache" clear
		"$BW_CLI" lock >/dev/null 2>&1 || true
		echo 'ERROR: expiry timer failed; bridge closed' >&2
		exit 1
	fi
	echo "OK: verified Bitwarden session cached in private runtime tmpfs for $hours hours."
	exit 0
fi
/usr/bin/security add-generic-password -U -a "$USER" -s "$SERVICE" -w "$session"
unset session
mkdir -p "$STATE_DIR"
echo "$expires" >"$EXPIRES_AT"

echo "OK: verified Bitwarden session cached in Login Keychain ($SERVICE) until $(date -r "$expires" '+%a %H:%M')."
echo "Close early:  ~/code/personal-infra/tools/access/bitwarden-session close"
