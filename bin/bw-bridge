#!/bin/bash
# Bridge an unlocked Bitwarden session into the macOS Login Keychain so
# Codex / Claude Code can use bw without seeing any credential.
# Interactive by design: the master password goes only into bw's own prompt.
# The session (revocable, not the master password) is passed to `security`
# as an argument — brief ps exposure, within the same-user Keychain tradeoff
# documented in ~/code/personal-infra/runbooks/access/bitwarden.md.
set -euo pipefail

status="$(bw status | jq -r .status)"
if [[ "$status" == "unauthenticated" ]]; then
	bw login
fi

session="$(bw unlock --raw)"
/usr/bin/security add-generic-password \
	-U -a "$USER" -s personal-infra-bitwarden-session -w "$session"
unset session

check="$(BW_SESSION="$(/usr/bin/security find-generic-password \
	-a "$USER" -s personal-infra-bitwarden-session -w)" bw status | jq -r .status)"
if [[ "$check" != "unlocked" ]]; then
	echo "ERROR: cached session does not unlock the vault (status: $check)" >&2
	exit 1
fi

echo "OK: verified Bitwarden session cached in Login Keychain (personal-infra-bitwarden-session)."
echo "When finished:  security delete-generic-password -a \"\$USER\" -s personal-infra-bitwarden-session"
