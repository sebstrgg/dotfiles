#!/usr/bin/env bash
# Keep a Claude 5-hour usage window running back to back, even while idle.
#
# WHY: a 5-hour window only starts on the first request after the previous one
# resets. If nothing runs at reset time (overnight, say), the next window starts
# whenever work resumes, so a limit hit later lands hours after it needed to.
# Run every few minutes by launchd; it pings Haiku only once the last known
# window has expired, then records the reset time the API reports. A ping inside
# an active window is harmless, so a stale state file self-corrects.
set -euo pipefail

state_dir="$HOME/.local/state/claude-window-keeper"
state="$state_dir/resets_at"
mkdir -p "$state_dir"

now=$(date +%s)
if [[ -f "$state" ]] && ((now < $(<"$state"))); then
	exit 0
fi

# Empty cwd so no project CLAUDE.md or settings ride along with the ping.
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT
cd "$workdir"

out=$(claude -p "Reply with just: ok" --model haiku --tools "" --strict-mcp-config \
	--no-session-persistence --output-format stream-json --verbose 2>/dev/null) || true

resets_at=$(jq -Rr 'fromjson? | select(.type == "rate_limit_event") | .rate_limit_info
	| .unifiedWindows.five_hour.resetsAt // (select(.rateLimitType == "five_hour") | .resetsAt) // empty' \
	<<<"$out" | tail -n 1)

if [[ ! "$resets_at" =~ ^[0-9]+$ ]]; then
	echo "$(date '+%F %T') ping returned no five-hour reset time; retrying next run" >&2
	exit 1
fi

echo "$resets_at" >"$state"
reset_display=$(date -r "$resets_at" '+%F %H:%M' 2>/dev/null || date -d "@$resets_at" '+%F %H:%M')
echo "$(date '+%F %T') window active until $reset_display"
