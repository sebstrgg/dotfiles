#!/usr/bin/env python3
"""Effort files, and the Claude Code and Codex hooks that hold a session to one.

  effort-gate new <effort>  Create .scratch/<effort>/effort.md in this checkout
                            from the template, owned by the calling session.
  effort-gate claim <file>  Make the calling session the owner (taking over).
  effort-gate stop [claude] Stop hook: block ending the turn while the session's
                            active effort file has open "done when" items.
  effort-gate context       Compaction hook: point the agent back at the file.
  effort-gate release <why> Mark this checkout's HEAD commit as a release: the
                            one commit allowed a full run on the shared CI farm
                            (bin/agent-tripwire holds every other), recorded
                            under "## CI runs" in the session's active effort.

An effort file is `.scratch/<effort>/effort.md` with front matter `status: active`
(or `done`, which is held too while an item is unfinished), `checkout:` naming
the checkout it lives in and `session:` naming the owning session. The gate
looks in every worktree of the session's repository. Only the owner is gated:
other sessions in the same checkout, and copies of the file in a checkout their
`checkout:` does not name, never match.

A run started by `bin/agent-run` in a delegated role carries AGENT_RUN_ROLE.
It works its orchestrator's brief: the hooks never gate it, and `new` and
`claim` refuse, since the effort file belongs to the orchestrator.
After MAX_IDENTICAL_BLOCKS stops without progress the gate stops blocking: it
marks the effort `blocked`, records why under "## Blockers" and warns the user.

A row under "## Running tasks" whose state says `running` means the agent waits on
a job. Claude Code wakes a session when its background task ends, so its Stop hook
passes `claude` and the gate lets that session end its turn. Codex has no such
wake-up: the gate holds the session and asks for a blocking wait. These stops count
toward the cap too, so a stale `running` row ends in `blocked` rather than holding
or freeing the session forever; any change to an item or task row is progress.
An effort file over SIZE_LIMIT bytes asks for a rewrite into current state,
once per further SIZE_LIMIT it grows. Verification evidence belongs in the
"Done when" table; the hook does not inspect child-task records.
"""
import contextlib
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

MAX_IDENTICAL_BLOCKS = 5
SIZE_LIMIT = 20_000
SKILLS = Path(__file__).resolve().parent.parent / 'agents' / 'skills'
TEMPLATE = (Path(__file__).resolve().parents[1]
            / 'agents' / 'skills' / 'engineering-workflow' / 'templates' / 'effort.md')
SESSION_VARIABLES = {'codex': 'CODEX_THREAD_ID', 'claude': 'CLAUDE_CODE_SESSION_ID'}
RUNTIMES_THAT_WAKE = {'claude'}
# A row whose runtime names T3 (a child task, watched pull request or schedule)
# wakes its thread in either runtime.
T3_OWNED = re.compile(r'\bT3\b')


def read_event():
    try:
        event = json.loads(sys.stdin.read() or '{}')
    except ValueError:
        event = {}
    return event if isinstance(event, dict) else {}


def checkout_root(cwd):
    try:
        result = subprocess.run(['git', '-C', str(cwd), 'rev-parse', '--show-toplevel'],
                                capture_output=True, text=True, timeout=3, check=False)
        if result.returncode == 0 and result.stdout.strip():
            return Path(result.stdout.strip()).resolve()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path(cwd).resolve()


def front_matter(text):
    lines = text.splitlines()
    if not lines or lines[0].strip() != '---':
        return {}
    fields = {}
    for line in lines[1:]:
        if line.strip() == '---':
            break
        key, _, value = line.partition(':')
        fields[key.strip()] = value.split('#')[0].strip()
    return fields


FINISHED = {'pass', 'blocked'}
GATED = {'active', 'done'}  # `done` with an unfinished item is not done


def table(text, section):
    """Rows of the first table under `## <section>`, as dicts keyed by lowercased header."""
    rows, header, in_section = [], None, False
    for line in text.splitlines():
        if line.startswith('## '):
            in_section = line[3:].strip().lower() == section
            continue
        if not in_section or not line.strip().startswith('|'):
            continue
        inner = line.strip()[1:]
        if inner.endswith('|') and not inner.endswith('\\|'):
            inner = inner[:-1]
        cells = [cell.strip() for cell in re.split(r'(?<!\\)\|', inner)]
        if header is None:
            header = [cell.lower() for cell in cells]
        elif not all(set(cell) <= set('-: ') for cell in cells):
            rows.append(dict(zip(header, cells)))
    return rows


def open_items(text):
    """Rows of the "Done when" table not yet `pass` or `blocked`: any other status,
    including `fail` or a misspelling, keeps the item open. So does a `pass` whose
    evidence names a substitute check: a substitute never closes an item. A
    "Done when" without table rows is one open item, since nothing can be read."""
    rows = table(text, 'done when')
    if not rows:
        return ['"Done when" is not in the template table (| # | Item | Check on the real '
                'target | Status | Evidence |), so the gate cannot read its items']
    items = []
    for row in rows:
        name = f"#{row.get('#', '?')} {row.get('item', '').strip()}".strip()
        status = row.get('status', '').strip('`* ').lower()
        if status == 'pass' and re.search(r'\bsubstitute', row.get('evidence', ''), re.IGNORECASE):
            items.append(f'{name} (substitute evidence)')
        elif status not in FINISHED:
            items.append(name)
    return items


def table_rows(text, section):
    return ['|'.join(row.values()) for row in table(text, section)]


def running_rows(text):
    return [row for row in table(text, 'running tasks')
            if re.search(r'\brunning\b', row.get('state', ''), re.IGNORECASE)]


def row_runtime(row):
    return next((value for key, value in row.items() if key.startswith('runtime')), '')


def running_tasks(text):
    return [row.get('task', '?') for row in running_rows(text)]


def worktree_roots(cwd):
    """This checkout's root, then every other worktree of its repository."""
    root = checkout_root(cwd)
    try:
        result = subprocess.run(['git', '-C', str(root), 'worktree', 'list', '--porcelain'],
                                capture_output=True, text=True, timeout=3, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return [root]
    others = [Path(line.removeprefix('worktree ')).resolve()
              for line in result.stdout.splitlines() if line.startswith('worktree ')]
    return [root] + [tree for tree in others if tree != root]


def owned_efforts(cwd, session_id):
    """(path, text, status) of each effort file the session owns in any worktree
    of this repository, counted only in the checkout its `checkout:` names."""
    efforts = []
    if not session_id:
        return efforts
    for root in worktree_roots(cwd):
        for path in sorted(root.glob('.scratch/*/effort.md')):
            try:
                text = path.read_text(errors='replace')
            except OSError:
                continue
            fields = front_matter(text)
            checkout = fields.get('checkout', '')
            if (fields.get('session') == session_id
                    and checkout and Path(checkout).expanduser().resolve() == root):
                efforts.append((path, text, fields.get('status')))
    return efforts


def active_effort(cwd, session_id):
    for path, text, status in owned_efforts(cwd, session_id):
        if status == 'active':
            return path, text
    return None, None


def own_session_id():
    """Id of the agent session running this command. A session started from another
    agent inherits that agent's variable too, so the nearest runtime process decides.
    Where `ps` is unavailable (the Codex sandbox), Codex's own variable wins. Exits
    when no agent session runs this command."""
    ids = {runtime: os.environ.get(variable) for runtime, variable in SESSION_VARIABLES.items()}
    pid = os.getppid()
    for _ in range(10):
        try:
            result = subprocess.run(['ps', '-o', 'ppid=,comm=', '-p', str(pid)],
                                    capture_output=True, text=True, timeout=3, check=False)
        except (OSError, subprocess.TimeoutExpired):
            break
        fields = result.stdout.split(None, 1)
        if len(fields) != 2 or not fields[0].isdigit():
            break
        runtime = Path(fields[1].strip()).name
        if ids.get(runtime):
            return ids[runtime]
        pid = int(fields[0])
        if pid <= 1:
            break
    if ids['codex'] or ids['claude']:
        return ids['codex'] or ids['claude']
    sys.exit('effort-gate: no session id ($CLAUDE_CODE_SESSION_ID or $CODEX_THREAD_ID); '
             'run this from the agent session that owns the effort')


def set_owner(text, session_id):
    return re.sub(r'^session:.*$', f'session: {session_id}', text, count=1, flags=re.MULTILINE)


def new(name):
    session_id = own_session_id()
    root = checkout_root(os.getcwd())
    path = root / '.scratch' / name / 'effort.md'
    if path.exists():
        sys.exit(f'effort-gate: {path} exists; to take it over: effort-gate claim {path}')
    text = re.sub(r'^checkout:.*$', f'checkout: {root}', TEMPLATE.read_text(), count=1,
                  flags=re.MULTILINE)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(set_owner(text, session_id))
    ignored = subprocess.run(['git', '-C', str(root), 'check-ignore', '-q', str(path)],
                             capture_output=True, check=False).returncode == 0
    exclude = subprocess.run(['git', '-C', str(root), 'rev-parse', '--path-format=absolute',
                              '--git-path', 'info/exclude'],
                             capture_output=True, text=True, check=False).stdout.strip()
    if not ignored and exclude:
        # The repository's local exclude file keeps .scratch/ out of git without a
        # change to the tracked .gitignore.
        exclude = Path(exclude)
        existing = exclude.read_text() if exclude.exists() else ''
        separator = '\n' if existing and not existing.endswith('\n') else ''
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text(f'{existing}{separator}.scratch/\n')
    print(path)


def claim(file):
    session_id = own_session_id()
    path = Path(file).expanduser().resolve()
    path.write_text(set_owner(path.read_text(), session_id))
    print(f'{path} is now owned by session {session_id}')


def counter_path(session_id):
    name = hashlib.sha256(str(session_id).encode()).hexdigest()[:16]
    return Path(tempfile.gettempdir()) / 'effort-gate' / name


def mark_blocked(path, text, items):
    """Set `status: blocked` and record the stall, so the effort reads as stuck."""
    note = (f'- The agent stopped {MAX_IDENTICAL_BLOCKS} times without progress on: '
            f'{"; ".join(items)}. Needs a new approach or Sebastian.')
    text = re.sub(r'^status:.*$', 'status: blocked', text, count=1, flags=re.MULTILINE)
    heading = re.search(r'^## Blockers[ \t]*\n', text, flags=re.MULTILINE)
    if heading:
        rest = re.sub(r'^\s*None\.[ \t]*\n', '', text[heading.end():], count=1)
        text = f'{text[:heading.end()]}\n{note}\n{rest}'
    else:
        text = f'{text.rstrip()}\n\n## Blockers\n\n{note}\n'
    path.write_text(text)


def oversized(path, text, session_id):
    """A hold when the file has grown into a further SIZE_LIMIT than this owner was
    last asked about; shrinking and growing back asks nothing new."""
    size = len(text.encode())
    if size <= SIZE_LIMIT:
        return None
    marker = path.parent / '.size-question'
    try:
        owner, asked = marker.read_text().split()
        asked = int(asked) if owner == session_id else 0
    except (FileNotFoundError, ValueError):
        asked = 0
    except OSError:
        return None
    bucket = size // SIZE_LIMIT
    if bucket <= asked:
        return None
    try:
        marker.write_text(f'{session_id} {bucket}\n')
    except OSError:
        return None
    return {'decision': 'block', 'reason': (
        f'{path} is {size // 1000} KB; the limit is {SIZE_LIMIT // 1000} KB. Rewrite it as current '
        'state in plain sentences a fresh reader follows: delete finished history and logs; '
        'keep open items, decisions with reasons, approvals '
        'and running tasks.')}


def stop(event, runtime=None):
    session_id = str(event.get('session_id', ''))
    efforts = owned_efforts(event.get('cwd') or os.getcwd(), session_id)
    if not efforts:
        return None
    for path, text, status in efforts:
        if status not in GATED:
            continue
        held = oversized(path, text, session_id)
        if held:
            return held
    for path, text, status in efforts:
        if status in GATED and (open_items(text) or running_tasks(text)):
            return hold(path, text, open_items(text), session_id, runtime)
    with contextlib.suppress(OSError):
        counter_path(session_id).unlink(missing_ok=True)
    return None


def stops_without_progress(session_id, signature):
    """Record this stop and return how many stops before it had the same signature,
    resetting the count once it reaches the cap. Raises OSError when the counter
    cannot be kept."""
    counter = counter_path(session_id)
    try:
        previous, count = counter.read_text().split()
        count = int(count) if previous == signature else 0
    except (FileNotFoundError, ValueError):
        count = 0
    if count >= MAX_IDENTICAL_BLOCKS:
        counter.unlink(missing_ok=True)
    else:
        counter.parent.mkdir(parents=True, exist_ok=True)
        counter.write_text(f'{signature} {count + 1}')
    return count


def hold(path, text, items, session_id, runtime):
    """Block the owner's stop while items are open or a task runs, until the stall
    cap marks the effort blocked."""
    tasks = running_tasks(text)
    pending = items or [f'{task} (running)' for task in tasks]
    rows = table_rows(text, 'done when') + table_rows(text, 'running tasks')
    signature = hashlib.sha256('\n'.join(rows).encode()).hexdigest()
    try:
        count = stops_without_progress(session_id, signature)
    except OSError:
        return {'systemMessage': (
            f'Effort gate: cannot keep its stop counter, so it is not holding the session. '
            f'{path} still has open work: {"; ".join(pending)}.')}
    if count >= MAX_IDENTICAL_BLOCKS:
        mark_blocked(path, text, pending)
        return {'systemMessage': (
            f'Effort gate: the agent stopped {MAX_IDENTICAL_BLOCKS} times without progress. '
            f'{path} is now marked blocked; still open: {"; ".join(pending)}.')}
    unwoken = [row.get('task', '?') for row in running_rows(text)
               if runtime not in RUNTIMES_THAT_WAKE and not T3_OWNED.search(row_runtime(row))]
    if tasks and not unwoken:
        return None
    if tasks:
        return {'decision': 'block', 'reason': (
            f'{path} records a running task nothing will wake you for: {"; ".join(unwoken)}. '
            'Wait for it with one blocking '
            'wait on its completion (its process or exit marker), then continue. If it has '
            'already finished, record that and continue.')}
    return {'decision': 'block', 'reason': (
        f'{path} has "done when" items not yet `pass`: {"; ".join(items)}. '
        'Continue the work. An item becomes `pass` when a fresh verifier (a T3 child task '
        'from the other model family, see `delegate`) passes it on the real target and '
        'its thread is cited in Evidence; a '
        'substitute check never makes an item `pass`. If you cannot proceed, '
        'record the blocker and set `status: blocked`; once every item passes, set '
        '`status: done`. End with a report of the work to Sebastian.')}


def context(event):
    path, text = active_effort(event.get('cwd') or os.getcwd(), str(event.get('session_id', '')))
    if path is None:
        return None
    items = open_items(text)
    message = (f'Active effort file: {path}. Re-read it now and resume from its Next section. '
               f'Open items: {"; ".join(items) if items else "none"}. Skills loaded before '
               f'compaction may be older than their files: read {SKILLS}/engineering-workflow/'
               'SKILL.md again, and any other skill you are following.')
    return {'hookSpecificOutput': {'hookEventName': event.get('hook_event_name', 'SessionStart'),
                                   'additionalContext': message}}


def git(root, *args):
    return subprocess.run(['git', '-C', str(root), *args],
                          capture_output=True, text=True, check=False)


def add_ci_run(text, row):
    """`text` with `row` appended to the "## CI runs" table, adding the section
    before "## Decisions" (or at the end) in an effort file that predates it."""
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if line.strip().lower() == '## ci runs'), None)
    if start is None:
        section = ['## CI runs', '', '| Commit | Started | Why it is the release |',
                   '|---|---|---|', row, '']
        at = next((i for i, line in enumerate(lines) if line.strip().lower() == '## decisions'),
                  len(lines))
        lines[at:at] = section
    else:
        end = start + 1
        while end < len(lines) and not lines[end].startswith('## '):
            end += 1
        last = max((i for i in range(start, end) if lines[i].strip().startswith('|')), default=None)
        if last is None:
            lines[start + 1:start + 1] = ['', '| Commit | Started | Why it is the release |',
                                          '|---|---|---|', row]
        else:
            lines.insert(last + 1, row)
    return '\n'.join(lines) + '\n'


def release(why):
    """Record HEAD as the commit allowed one full CI run. A dirty tree is refused:
    CI would test something other than what the checkout holds."""
    root = checkout_root(os.getcwd())
    head = git(root, 'rev-parse', 'HEAD').stdout.strip()
    if not head:
        sys.exit('effort-gate: release needs a git checkout with a commit')
    if git(root, 'status', '--porcelain', '--', '.', ':(exclude).scratch').stdout.strip():
        sys.exit('effort-gate: uncommitted or untracked files; commit the whole release first')
    common = Path(git(root, 'rev-parse', '--path-format=absolute', '--git-common-dir').stdout.strip())
    started = datetime.now().astimezone().strftime('%Y-%m-%d %H:%M %Z')
    why = ' '.join(why.split()).replace('|', '\\|')
    with open(common / 'agent-ci-release', 'a') as marks:
        marks.write(f'{head}\t{started}\t{why}\n')
    session_id = None
    with contextlib.suppress(SystemExit):
        session_id = own_session_id()
    path, text = active_effort(root, session_id)
    if path:
        path.write_text(add_ci_run(text, f'| {head[:12]} | {started} | {why} |'))
    print(f'{head[:12]} may start one full CI run'
          + (f'; recorded in {path}' if path else ''))


def main():
    role = os.environ.get('AGENT_RUN_ROLE')
    if len(sys.argv) == 3 and sys.argv[1] == 'release':
        if role:
            sys.exit(f'effort-gate: this is a delegated {role} run (AGENT_RUN_ROLE). Starting a '
                     'full CI run is the orchestrator\'s call: push to a draft and report.')
        release(sys.argv[2])
        return 0
    if len(sys.argv) == 3 and sys.argv[1] in ('new', 'claim'):
        if role:
            sys.exit(f'effort-gate: this is a delegated {role} run (AGENT_RUN_ROLE). The effort '
                     'file belongs to the orchestrator that started it: work its brief and end '
                     'with your report.')
        (new if sys.argv[1] == 'new' else claim)(sys.argv[2])
        return 0
    runtime = sys.argv[2] if len(sys.argv) == 3 and sys.argv[1] == 'stop' else None
    if len(sys.argv) != (3 if runtime else 2) or sys.argv[1] not in ('stop', 'context'):
        print(__doc__, file=sys.stderr)
        return 2
    event = read_event()
    if role:
        return 0
    output = stop(event, runtime) if sys.argv[1] == 'stop' else context(event)
    if output:
        print(json.dumps(output))
    return 0


if __name__ == '__main__':
    sys.exit(main())
