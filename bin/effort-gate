#!/usr/bin/env python3
"""Effort files, and the Claude Code and Codex hooks that hold a session to one.

  effort-gate new <effort>  Create .scratch/<effort>/effort.md in this checkout
                            from the template, owned by the calling session.
  effort-gate claim <file>  Make the calling session the owner (taking over).
  effort-gate stop [claude] Stop hook: block ending the turn while the session's
                            active effort file has open "done when" items.
  effort-gate context       Compaction hook: point the agent back at the file.

An effort file is `.scratch/<effort>/effort.md` with front matter `status: active`
(or `done`, which is held too while an item is unfinished), `checkout:` equal to
this checkout and `session:` naming the owning session. Only
the owner is gated: verifiers and workers running in the same checkout, and
copies of the file in other worktrees, never match.
After MAX_IDENTICAL_BLOCKS stops without progress the gate stops blocking: it
marks the effort `blocked`, records why under "## Blockers" and warns the user.

A row under "## Running tasks" whose state says `running` means the agent waits on
a job. Claude Code wakes a session when its background task ends, so its Stop hook
passes `claude` and the gate lets that session end its turn. Codex has no such
wake-up: the gate holds the session and asks for a blocking wait. These stops count
toward the cap too, so a stale `running` row ends in `blocked` rather than holding
or freeing the session forever; any change to an item or task row is progress.

When the owner ends a turn on a finished effort (status `done` or `blocked`, or
every item passed with nothing running), the gate holds it once more in two
cases: items are `pass` but no `verify` run by the other runtime has finished
under the effort's `runs/` folder (`bin/agent-run` records each run there) after
starting no earlier than the checkout's newest commit, or
the brief still lists reserved actions under "Not approved" and the last message
asks fewer questions than it lists actions (one per list item or `;`-separated
part). Markers beside the effort file keep each to once per owner and subject; a
new commit is a new subject for the verify question.
"""
import contextlib
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime
from pathlib import Path

MAX_IDENTICAL_BLOCKS = 5
TEMPLATE = (Path(__file__).resolve().parents[1]
            / 'agents' / 'skills' / 'engineering-workflow' / 'templates' / 'effort.md')
SESSION_VARIABLES = {'codex': 'CODEX_THREAD_ID', 'claude': 'CLAUDE_CODE_SESSION_ID'}
RUNTIMES_THAT_WAKE = {'claude'}
OTHER_FAMILY = {'claude': 'codex', 'codex': 'claude'}
FAMILY_NAMES = {'claude': 'Claude', 'codex': 'Codex'}


def read_event():
    try:
        event = json.loads(sys.stdin.read() or '{}')
    except ValueError:
        event = {}
    return event if isinstance(event, dict) else {}


def checkout_root(cwd):
    try:
        result = subprocess.run(['git', '-C', str(cwd), 'rev-parse', '--show-toplevel'],
                                capture_output=True, text=True, timeout=3, check=False)
        if result.returncode == 0 and result.stdout.strip():
            return Path(result.stdout.strip()).resolve()
    except (OSError, subprocess.TimeoutExpired):
        pass
    return Path(cwd).resolve()


def front_matter(text):
    lines = text.splitlines()
    if not lines or lines[0].strip() != '---':
        return {}
    fields = {}
    for line in lines[1:]:
        if line.strip() == '---':
            break
        key, _, value = line.partition(':')
        fields[key.strip()] = value.split('#')[0].strip()
    return fields


FINISHED = {'pass', 'blocked'}
GATED = {'active', 'done'}  # `done` with an unfinished item is not done


def table(text, section):
    """Rows of the first table under `## <section>`, as dicts keyed by lowercased header."""
    rows, header, in_section = [], None, False
    for line in text.splitlines():
        if line.startswith('## '):
            in_section = line[3:].strip().lower() == section
            continue
        if not in_section or not line.strip().startswith('|'):
            continue
        inner = line.strip()[1:]
        if inner.endswith('|') and not inner.endswith('\\|'):
            inner = inner[:-1]
        cells = [cell.strip() for cell in re.split(r'(?<!\\)\|', inner)]
        if header is None:
            header = [cell.lower() for cell in cells]
        elif not all(set(cell) <= set('-: ') for cell in cells):
            rows.append(dict(zip(header, cells)))
    return rows


def open_items(text):
    """Rows of the "Done when" table not yet `pass` or `blocked`: any other status,
    including `fail` or a misspelling, keeps the item open. So does a `pass` whose
    evidence names a substitute check: a substitute never closes an item."""
    items = []
    for row in table(text, 'done when'):
        name = f"#{row.get('#', '?')} {row.get('item', '').strip()}".strip()
        status = row.get('status', '').strip('`* ').lower()
        if status == 'pass' and re.search(r'\bsubstitute', row.get('evidence', ''), re.IGNORECASE):
            items.append(f'{name} (substitute evidence)')
        elif status not in FINISHED:
            items.append(name)
    return items


def table_rows(text, section):
    return ['|'.join(row.values()) for row in table(text, section)]


def running_tasks(text):
    return [row.get('task', '?') for row in table(text, 'running tasks')
            if re.search(r'\brunning\b', row.get('state', ''), re.IGNORECASE)]


def owned_efforts(cwd, session_id):
    """(path, text, status) of each effort file in this checkout that the session owns."""
    root, efforts = checkout_root(cwd), []
    for path in sorted(root.glob('.scratch/*/effort.md')):
        try:
            text = path.read_text(errors='replace')
        except OSError:
            continue
        fields = front_matter(text)
        checkout = fields.get('checkout', '')
        if (session_id and fields.get('session') == session_id
                and checkout and Path(checkout).expanduser().resolve() == root):
            efforts.append((path, text, fields.get('status')))
    return efforts


def active_effort(cwd, session_id):
    for path, text, status in owned_efforts(cwd, session_id):
        if status == 'active':
            return path, text
    return None, None


NOT_APPROVED = re.compile(r'\s*(?:[-*+]\s+)?\*\*not approved:?\*\*:?(.*)', re.IGNORECASE)
FIELD = re.compile(r'\s*(?:[-*+]\s+)?\*\*[^*]+?(?::\*\*|\*\*:)')
LIST_ITEM = re.compile(r'\s*(?:[-*+]|\d+[.)])\s')
LIST_MARKER = re.compile(r'(?:^|\s)(?:[-*+]|\d+[.)])\s')  # a list item within joined text
LINK = re.compile(r'\b[a-z][a-z0-9+.-]*://[^\s)]*[^\s).,?!:;]', re.IGNORECASE)
# The template's earlier prompts; older effort files keep them.
EARLIER_PLACEHOLDERS = {
    'reserved actions that are still open.',
    'reserved actions still open, including follow-ups the request leaves undecided '
    '(rotating an exposed secret, going public), or `None.`; the final report asks each '
    'as a yes/no question.',
}


def not_approved_text(text):
    """The brief's "Not approved" paragraph or list, as one line. It runs to the
    next field or heading; a blank line ends it unless a list item follows."""
    lines = text.splitlines()
    for index, line in enumerate(lines):
        label = NOT_APPROVED.match(line)
        if not label:
            continue
        parts, rest = [label.group(1).strip()], lines[index + 1:]
        for position, following in enumerate(rest):
            if not following.strip():
                upcoming = next((line for line in rest[position + 1:] if line.strip()), '')
                if LIST_ITEM.match(upcoming) or not any(parts):
                    continue
                break
            if FIELD.match(following) or following.lstrip().startswith('#'):
                break
            parts.append(following.strip())
        return ' '.join(part for part in parts if part)
    return ''


def reserved_actions(text):
    """The reserved actions the brief leaves open; '' for none or a template prompt."""
    listed = not_approved_text(text)
    placeholders = set(EARLIER_PLACEHOLDERS)
    with contextlib.suppress(OSError):
        placeholders.add(not_approved_text(TEMPLATE.read_text()))
    if listed in placeholders or listed.strip('`*_ .').lower() in ('', 'none', 'nothing'):
        return ''
    return listed


def action_count(reserved):
    """How many actions a "Not approved" text lists: list items, split further at
    semicolons outside parentheses. Commas and "and" sit inside single actions
    too often to split on."""
    count = 0
    for item in LIST_MARKER.split(reserved):
        depth, part = 0, ''
        for char in item + ';':
            depth = max(0, depth + {'(': 1, ')': -1}.get(char, 0))
            if char == ';' and depth == 0:
                count += bool(part.strip(' .'))
                part = ''
            else:
                part += char
    return max(1, count)


def asks(message, count=1):
    """Whether a message ends asking at least `count` questions: `?` marks in its
    last lines, outside links and code."""
    if not isinstance(message, str):
        return False
    prose = re.sub(r'```.*?(?:```|\Z)', '', message, flags=re.DOTALL)
    lines = [LINK.sub('', re.sub(r'`[^`]*`', '', line)) for line in prose.splitlines()
             if line.strip()]
    return sum(line.count('?') for line in lines[-(count + 4):]) >= count


def closing(text, status):
    """Whether the effort is at its close: `done` or `blocked`, or every item passed
    with nothing running."""
    if status in ('done', 'blocked'):
        return True
    rows = table(text, 'done when')
    return (bool(rows) and not running_tasks(text)
            and all(row.get('status', '').strip('`* ').lower() == 'pass' for row in rows))


def own_session_id():
    """Id of the agent session running this command. A session started from another
    agent inherits that agent's variable too, so the nearest runtime process decides.
    Where `ps` is unavailable (the Codex sandbox), Codex's own variable wins. Exits
    when no agent session runs this command."""
    ids = {runtime: os.environ.get(variable) for runtime, variable in SESSION_VARIABLES.items()}
    pid = os.getppid()
    for _ in range(10):
        try:
            result = subprocess.run(['ps', '-o', 'ppid=,comm=', '-p', str(pid)],
                                    capture_output=True, text=True, timeout=3, check=False)
        except (OSError, subprocess.TimeoutExpired):
            break
        fields = result.stdout.split(None, 1)
        if len(fields) != 2 or not fields[0].isdigit():
            break
        runtime = Path(fields[1].strip()).name
        if ids.get(runtime):
            return ids[runtime]
        pid = int(fields[0])
        if pid <= 1:
            break
    if ids['codex'] or ids['claude']:
        return ids['codex'] or ids['claude']
    sys.exit('effort-gate: no session id ($CLAUDE_CODE_SESSION_ID or $CODEX_THREAD_ID); '
             'run this from the agent session that owns the effort')


def set_owner(text, session_id):
    return re.sub(r'^session:.*$', f'session: {session_id}', text, count=1, flags=re.MULTILINE)


def new(name):
    session_id = own_session_id()
    root = checkout_root(os.getcwd())
    path = root / '.scratch' / name / 'effort.md'
    if path.exists():
        sys.exit(f'effort-gate: {path} exists; to take it over: effort-gate claim {path}')
    text = re.sub(r'^checkout:.*$', f'checkout: {root}', TEMPLATE.read_text(), count=1,
                  flags=re.MULTILINE)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(set_owner(text, session_id))
    ignored = subprocess.run(['git', '-C', str(root), 'check-ignore', '-q', str(path)],
                             capture_output=True, check=False).returncode == 0
    exclude = subprocess.run(['git', '-C', str(root), 'rev-parse', '--path-format=absolute',
                              '--git-path', 'info/exclude'],
                             capture_output=True, text=True, check=False).stdout.strip()
    if not ignored and exclude:
        # The repository's local exclude file keeps .scratch/ out of git without a
        # change to the tracked .gitignore.
        exclude = Path(exclude)
        existing = exclude.read_text() if exclude.exists() else ''
        separator = '\n' if existing and not existing.endswith('\n') else ''
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text(f'{existing}{separator}.scratch/\n')
    print(path)


def claim(file):
    session_id = own_session_id()
    path = Path(file).expanduser().resolve()
    path.write_text(set_owner(path.read_text(), session_id))
    print(f'{path} is now owned by session {session_id}')


def counter_path(session_id):
    name = hashlib.sha256(str(session_id).encode()).hexdigest()[:16]
    return Path(tempfile.gettempdir()) / 'effort-gate' / name


def mark_blocked(path, text, items):
    """Set `status: blocked` and record the stall, so the effort reads as stuck."""
    note = (f'- The agent stopped {MAX_IDENTICAL_BLOCKS} times without progress on: '
            f'{"; ".join(items)}. Needs a new approach or Sebastian.')
    text = re.sub(r'^status:.*$', 'status: blocked', text, count=1, flags=re.MULTILINE)
    heading = re.search(r'^## Blockers[ \t]*\n', text, flags=re.MULTILINE)
    if heading:
        rest = re.sub(r'^\s*None\.[ \t]*\n', '', text[heading.end():], count=1)
        text = f'{text[:heading.end()]}\n{note}\n{rest}'
    else:
        text = f'{text.rstrip()}\n\n## Blockers\n\n{note}\n'
    path.write_text(text)


def stop(event, runtime=None):
    session_id = str(event.get('session_id', ''))
    efforts = owned_efforts(event.get('cwd') or os.getcwd(), session_id)
    if not efforts:
        return None
    for path, text, status in efforts:
        if status in GATED and (open_items(text) or running_tasks(text)):
            return hold(path, text, open_items(text), session_id, runtime)
    with contextlib.suppress(OSError):
        counter_path(session_id).unlink(missing_ok=True)
    last_message = event.get('last_assistant_message')
    other = OTHER_FAMILY[runtime or 'codex']
    for path, text, status in efforts:
        if not closing(text, status):
            continue
        since, commit = newest_commit(path.parents[2])
        if (passed(text) and not verified_by(path, other, since)
                and first_time(path, '.verify-question', session_id, f'{other} {commit}')):
            return {'decision': 'block', 'reason': (
                f'{path} has items marked `pass`, but no `verify` run by '
                f'{FAMILY_NAMES[other]} has finished under {path.parent / "runs"} since the '
                'newest commit in this checkout. Only a fresh verify from the other model family, '
                'run on the final change, makes an item `pass`; a same-family check adds '
                f'evidence. Run one now with `agent-run`. If {FAMILY_NAMES[other]} could not run, '
                'set those items back to `open` or `blocked`, record why, and correct your '
                'report. If it did pass them by another route, name that run in Evidence.')}
        reserved = reserved_actions(text)
        if (reserved and not asks(last_message, action_count(reserved))
                and first_time(path, '.close-question', session_id, reserved)):
            return {'decision': 'block', 'reason': (
                f'{path} lists reserved actions under "Not approved": {reserved.rstrip(".")}. '
                'End your report with each one still open as a yes/no question to Sebastian '
                'with your recommended answer, above all one his request left undecided. An '
                'action leaves "Not approved" only once Sebastian has answered it: move it to '
                '"Approved" with where he answered.')}
    return None


def passed(text):
    return any(row.get('status', '').strip('`* ').lower() == 'pass'
               for row in table(text, 'done when'))


def newest_commit(checkout):
    """The checkout's HEAD as (commit time in epoch seconds, hash); (None, None)
    outside git or before the first commit."""
    try:
        result = subprocess.run(['git', '-C', str(checkout), 'log', '-1', '--format=%ct %H'],
                                capture_output=True, text=True, timeout=5)
        when, commit = result.stdout.split()
        return int(when), commit
    except (OSError, ValueError, subprocess.SubprocessError):
        return None, None


def verified_by(path, runtime, since):
    """Whether a `verify` run by `runtime` has finished under the effort's runs
    folder, started no earlier than `since` (epoch seconds, or None for any time):
    a verify from before the latest commit did not check it."""
    for record in path.parent.glob('runs/*/command.json'):
        try:
            run = json.loads(record.read_text())
            finished = (record.parent / 'exit').read_text().strip() == '0'
        except (OSError, ValueError):
            continue
        if not (finished and isinstance(run, dict) and run.get('role') == 'verify'
                and run.get('runtime') == runtime):
            continue
        try:
            started = datetime.strptime(str(run.get('started')), '%Y-%m-%dT%H:%M:%S%z').timestamp()
        except ValueError:
            started = None
        if since is None or (started is not None and started >= since):
            return True
    return False


def first_time(path, marker_name, session_id, subject):
    """Record a close-time question for this owner and subject; False if already
    asked, or if it cannot be recorded, since an unrecorded question would repeat."""
    marker = path.parent / marker_name
    signature = hashlib.sha256(f'{session_id}\n{subject}'.encode()).hexdigest()
    try:
        if marker.read_text(errors='replace').strip() == signature:
            return False
    except FileNotFoundError:
        pass
    except OSError:
        return False
    try:
        marker.write_text(f'{signature}\n')
    except OSError:
        return False
    return True


def stops_without_progress(session_id, signature):
    """Record this stop and return how many stops before it had the same signature,
    resetting the count once it reaches the cap. Raises OSError when the counter
    cannot be kept."""
    counter = counter_path(session_id)
    try:
        previous, count = counter.read_text().split()
        count = int(count) if previous == signature else 0
    except (FileNotFoundError, ValueError):
        count = 0
    if count >= MAX_IDENTICAL_BLOCKS:
        counter.unlink(missing_ok=True)
    else:
        counter.parent.mkdir(parents=True, exist_ok=True)
        counter.write_text(f'{signature} {count + 1}')
    return count


def hold(path, text, items, session_id, runtime):
    """Block the owner's stop while items are open or a task runs, until the stall
    cap marks the effort blocked."""
    tasks = running_tasks(text)
    pending = items or [f'{task} (running)' for task in tasks]
    rows = table_rows(text, 'done when') + table_rows(text, 'running tasks')
    signature = hashlib.sha256('\n'.join(rows).encode()).hexdigest()
    try:
        count = stops_without_progress(session_id, signature)
    except OSError:
        return {'systemMessage': (
            f'Effort gate: cannot keep its stop counter, so it is not holding the session. '
            f'{path} still has open work: {"; ".join(pending)}.')}
    if count >= MAX_IDENTICAL_BLOCKS:
        mark_blocked(path, text, pending)
        reserved = reserved_actions(text)
        return {'systemMessage': (
            f'Effort gate: the agent stopped {MAX_IDENTICAL_BLOCKS} times without progress. '
            f'{path} is now marked blocked; still open: {"; ".join(pending)}.'
            + (f' Not approved, for you to decide: {reserved.rstrip(".")}.' if reserved else ''))}
    if tasks and runtime in RUNTIMES_THAT_WAKE:
        return None
    if tasks:
        return {'decision': 'block', 'reason': (
            f'{path} records a running task: {"; ".join(tasks)}. Wait for it with one blocking '
            'wait on its completion (its process or exit marker), then continue. If it has '
            'already finished, record that and continue.')}
    return {'decision': 'block', 'reason': (
        f'{path} has "done when" items not yet `pass`: {"; ".join(items)}. '
        'Continue the work. An item becomes `pass` when a fresh `verify` run from the other '
        'model family (`~/dotfiles/bin/agent-run`, see `delegate`) passes it on the real target; a '
        'substitute check never makes an item `pass`. If you cannot proceed, '
        'record the blocker and set `status: blocked`; once every item passes, set '
        '`status: done`. End with a report of the work to Sebastian.')}


def context(event):
    path, text = active_effort(event.get('cwd') or os.getcwd(), str(event.get('session_id', '')))
    if path is None:
        return None
    items = open_items(text)
    message = (f'Active effort file: {path}. Re-read it now and resume from its Next section. '
               f'Open items: {"; ".join(items) if items else "none"}.')
    return {'hookSpecificOutput': {'hookEventName': event.get('hook_event_name', 'SessionStart'),
                                   'additionalContext': message}}


def main():
    if len(sys.argv) == 3 and sys.argv[1] in ('new', 'claim'):
        (new if sys.argv[1] == 'new' else claim)(sys.argv[2])
        return 0
    runtime = sys.argv[2] if len(sys.argv) == 3 and sys.argv[1] == 'stop' else None
    if len(sys.argv) != (3 if runtime else 2) or sys.argv[1] not in ('stop', 'context'):
        print(__doc__, file=sys.stderr)
        return 2
    event = read_event()
    output = stop(event, runtime) if sys.argv[1] == 'stop' else context(event)
    if output:
        print(json.dumps(output))
    return 0


if __name__ == '__main__':
    sys.exit(main())
