#!/usr/bin/env python3
"""PreToolUse hook for Claude Code and Codex: refuse a force-push, a process
listing that would copy process arguments into the transcript, and a full run on
the shared CI farm for a commit not marked as a release.

Reads the hook event on stdin. For a shell command that runs `git push` with
`--force`, `--mirror`, `-f` (alone or in a short-flag group) or a `+refspec`, it
prints a deny decision. `--force-with-lease` and `--force-if-includes` stay
allowed: they refuse to overwrite work the agent has not fetched. A `ps` or
`pgrep` that may print arguments is denied too: tools pass API keys and whole
environments as arguments, and a listing filtered through grep still carries
them. `ps` flags read differently per platform and mode, so only one plain
names-only form passes. Every other call passes silently.

A full CI run starts with `gh pr ready`, `gh pr create` without `--draft`,
`gh workflow run`, `gh run rerun`, and a `git push` to the default branch or to
the branch of a ready pull request. In a checkout with `.github/workflows`, such
a command passes only for a commit `effort-gate release` marked (listed in the
repository's `agent-ci-release` file), so CI runs once on a finished change
rather than on every round of iteration. A command for another repository
(`gh -R`), a push to a remote other than origin, help and dry runs pass, and so
does any command whose target git or gh cannot name within the lookup budget.
Commits are read from local refs, a `cd` is followed only at the top level, and
`remote.<name>.push` mappings are not read.

Permission rules match command text by position, so a force flag after the
remote, or `git -C <dir>` in front, slipped past them; this reads the words of
each simple command instead, skipping here-document bodies and comments. It is a
tripwire, not a boundary: a push hidden in `sh -c`, a script or an alias still
runs.
"""
import json
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

OPERATOR_CHARS = '();<>|&`'
GIT_OPTIONS_WITH_VALUE = {'-C', '-c', '--git-dir', '--work-tree', '--namespace'}
PUSH_OPTIONS_WITH_VALUE = {'-o', '--push-option', '--repo', '--receive-pack', '--exec'}
WRAPPERS = {  # wrapper -> its options that take a value
    'command': set(), 'exec': set(), 'nohup': set(), 'time': set(),
    'env': {'-u', '--unset', '-C', '--chdir', '-S', '--split-string'},
    'sudo': {'-u', '--user', '-g', '--group', '-h', '--host', '-C', '-D', '-p', '-r', '-t', '-U'},
    'nice': {'-n', '--adjustment'},
    'timeout': {'-s', '--signal', '-k', '--kill-after'},
}
CONTROL_WORDS = {'if', 'then', 'else', 'elif', 'do', 'while', 'until', '!', '{', '--'}
ASSIGNMENT = re.compile(r'[A-Za-z_][A-Za-z0-9_]*=')
PS_SELECTING_FLAGS = set('Aadhmrw')  # choose or sort processes, add no column (procps `-x` can)
PS_OPTIONS_WITH_VALUE = set('GUopt')
PS_NAME_FIELDS = {  # columns that never hold arguments or the environment, on macOS and procps
    'pid', 'ppid', 'pgid', 'sess', 'tpgid', 'uid', 'ruid', 'user', 'ruser', 'gid', 'rgid',
    'group', 'tty', 'tt', 'stat', 'state', 'rss', 'vsz', 'pcpu', 'pmem',
    'comm', 'ucomm', 'ucmd', 'etime', 'etimes', 'time', 'cputime', 'start', 'lstart',
    'nice', 'ni', 'pri', 'flags', 'wchan', 'nlwp'}
PGREP_OPTIONS_WITH_VALUE = set('FGMNPUdgrstu')


def simple_commands(text):
    """Word lists of each simple command, read the way the shell reads them: quotes
    protect, a backslash-newline joins, `#` at the start of a word comments out the
    rest of the line, here-document bodies are skipped, operators and line ends
    split commands, and command substitutions are read as commands too. Raises
    ValueError on an unterminated quote, which the shell would refuse to run."""
    commands = []
    read(text, 0, commands, inside=False)
    return [words for words in commands if words]


def read(text, i, commands, inside):
    """Append the commands in `text` from index `i` to `commands`. Inside a `$(`
    substitution, stop after its closing `)` and return the index past it."""
    n = len(text)
    words, word, heredocs, wants_delimiter, depth = [], None, [], False, 0

    def end_word():
        nonlocal word, wants_delimiter
        if word is not None:
            words.append(word)
            if wants_delimiter:
                heredocs.append(word)
                wants_delimiter = False
            word = None

    def end_command():
        nonlocal words
        end_word()
        commands.append(words)
        words = []

    while i < n:
        char = text[i]
        if char == '\\':
            if i + 1 < n and text[i + 1] != '\n':
                word = (word or '') + text[i + 1]
            i += 2
        elif char == "'":
            close = text.find("'", i + 1)
            if close < 0:
                raise ValueError('unterminated single quote')
            word = (word or '') + text[i + 1:close]
            i = close + 1
        elif char == '"':
            quoted, i = double_quoted(text, i + 1, commands)
            word = (word or '') + quoted
        elif char in ' \t\r':
            end_word()
            i += 1
        elif char == '#' and word is None:
            newline = text.find('\n', i)
            i = n if newline < 0 else newline
        elif char == '\n':
            end_command()
            i = skip_heredoc_bodies(text, i + 1, heredocs)
            heredocs = []
        elif text.startswith('<<<', i):
            end_command()
            i += 3
        elif text.startswith('<<', i):
            end_command()
            wants_delimiter = True
            i += 3 if text.startswith('<<-', i) else 2
        elif char == ')' and inside and depth == 0:
            end_command()
            return i + 1
        elif char in OPERATOR_CHARS:
            end_command()
            depth = max(0, depth + {'(': 1, ')': -1}.get(char, 0))
            i += 1
        else:
            word = (word or '') + char
            i += 1
    if inside:
        raise ValueError('unterminated command substitution')
    end_command()
    return i


def double_quoted(text, i, commands):
    """Read a double-quoted string from just past its opening quote, reading any
    command substitution in it as commands. Returns the string and the index past
    the closing quote."""
    quoted, n = '', len(text)
    while i < n:
        char = text[i]
        if char == '"':
            return quoted, i + 1
        if char == '\\' and i + 1 < n and text[i + 1] in '$`"\\\n':
            quoted += '' if text[i + 1] == '\n' else text[i + 1]
            i += 2
        elif text.startswith('$(', i) and not text.startswith('$((', i):
            i = read(text, i + 2, commands, inside=True)
        elif char == '`':
            close = text.find('`', i + 1)
            if close < 0:
                raise ValueError('unterminated backquote')
            read(text[i + 1:close], 0, commands, inside=False)
            i = close + 1
        else:
            quoted += char
            i += 1
    raise ValueError('unterminated double quote')


def skip_heredoc_bodies(text, i, delimiters):
    """Index past the here-document bodies that start at `i`, one per delimiter."""
    n = len(text)
    for delimiter in delimiters:
        while i < n:
            newline = text.find('\n', i)
            line = text[i:n if newline < 0 else newline]
            i = n if newline < 0 else newline + 1
            if line.strip() == delimiter:
                break
    return i


def strip_prefix(words):
    """Drop leading assignments, control words and wrappers such as `timeout 30`."""
    while words:
        if ASSIGNMENT.match(words[0]) or words[0] in CONTROL_WORDS:
            words = words[1:]
        elif words[0] in WRAPPERS:
            takes_value = WRAPPERS[words[0]]
            words = words[1:]
            while words and (words[0].startswith('-') or words[0][:1].isdigit()):
                words = words[2:] if words[0] in takes_value else words[1:]
        else:
            return words
    return words


def force_push(words):
    words = strip_prefix(words)
    if not words or words[0].rsplit('/', 1)[-1] != 'git':
        return False
    rest = words[1:]
    while rest and rest[0].startswith('-'):
        rest = rest[2:] if rest[0] in GIT_OPTIONS_WITH_VALUE else rest[1:]
    if not rest or rest[0] != 'push':
        return False
    arguments = iter(rest[1:])
    for word in arguments:
        if word in ('--force', '--mirror'):
            return True
        if word in PUSH_OPTIONS_WITH_VALUE:
            next(arguments, None)
        elif word.startswith('-') and not word.startswith('--'):
            for position, flag in enumerate(word[1:], start=2):
                if flag == 'f':
                    return True
                if flag == 'o':
                    if position == len(word):
                        next(arguments, None)
                    break
        elif word.startswith('+'):
            return True
    return False


def lists_arguments(words):
    """A `ps` or `pgrep` that may print process arguments. `ps` passes only in the
    form that reads the same on macOS (in either mode) and Linux: dashed flags
    that choose or sort processes, `-p`/`-t`/`-U`/`-G` with their values, and
    `-o` formats made only of name and number columns. `pgrep` is refused with
    `-a`, or `-l` with `-f`."""
    words = strip_prefix(words)
    if not words:
        return False
    name, rest = words[0].rsplit('/', 1)[-1], iter(words[1:])
    if name == 'pgrep':
        flags = set()
        for word in rest:
            if word == '--list-full':
                return True
            if word.startswith('-') and not word.startswith('--'):
                for letter in word[1:]:
                    if letter in PGREP_OPTIONS_WITH_VALUE:
                        break
                    flags.add(letter)
        return 'a' in flags or {'l', 'f'} <= flags
    if name != 'ps':
        return False
    formats, rest = [], iter(words[1:])
    for word in rest:
        if not word.startswith('-') or word.startswith('--'):
            return True  # BSD groups, long options and operands read differently per platform
        letters = word[1:]
        for position, letter in enumerate(letters, start=1):
            if letter in PS_OPTIONS_WITH_VALUE:
                value = letters[position:] or next(rest, '')
                if letter == 'o':
                    formats.append(value)
                break
            if letter not in PS_SELECTING_FLAGS:
                return True
    if any('%' in value for value in formats):
        return True  # procps reads a format it rejects again as AIX codes, where `%a` is the arguments
    fields = {field.partition('=')[0].partition(':')[0]
              for value in formats for field in re.split(r'[,\s]+', value)} - {''}
    return not formats or not fields <= PS_NAME_FIELDS


LOOKUP_BUDGET = 6.0  # seconds for every git and gh lookup of one hook call; Codex allows 10
lookup_deadline = None


def run(cwd, *command):
    """Stripped stdout of `command`, or '' when it fails, is unavailable or the
    lookup budget is spent."""
    global lookup_deadline
    lookup_deadline = lookup_deadline or time.monotonic() + LOOKUP_BUDGET
    remaining = lookup_deadline - time.monotonic()
    if remaining <= 0.1:
        return ''
    try:
        result = subprocess.run(command, cwd=cwd, capture_output=True, text=True,
                                timeout=remaining, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return ''
    return result.stdout.strip() if result.returncode == 0 else ''


def flag(words, *names):
    """Whether a boolean flag is on: present, or given a value other than false."""
    letters = {name[1] for name in names if len(name) == 2 and name[0] == '-'}
    for word in words:
        name, equals, value = word.partition('=')
        if name in names:
            return not equals or value.lower() not in ('false', '0', 'no')
        if word[:1] == '-' and word[1:2] != '-' and letters & set(word[1:]):
            return True  # a group such as `-df`
    return False


def value(words, *names):
    """The value of the first of `names` given as `--name value` or `--name=value`."""
    for index, word in enumerate(words):
        name, equals, given = word.partition('=')
        if name in names:
            return given if equals else (words[index + 1] if index + 1 < len(words) else None)
    return None


def operand(words, options_with_value=()):
    """The first argument after a gh subcommand, skipping options and their values."""
    arguments = iter(words)
    for word in arguments:
        if word in options_with_value:
            next(arguments, None)
        elif not word.startswith('-'):
            return word
    return None


def commit_of(cwd, ref):
    return run(cwd, 'git', 'rev-parse', '--verify', '-q', f'{ref}^{{commit}}') or None


def default_branch(cwd):
    """origin's default branch as the checkout records it, else as GitHub reports
    it; None when neither can say."""
    head = run(cwd, 'git', 'symbolic-ref', '--short', 'refs/remotes/origin/HEAD')
    if '/' in head:
        return head.split('/', 1)[1]
    return run(cwd, 'gh', 'repo', 'view', '--json', 'defaultBranchRef',
               '--jq', '.defaultBranchRef.name') or None


def on_github(cwd, remote):
    url = (run(cwd, 'git', 'config', '--get', f'remote.{remote}.pushurl')
           or run(cwd, 'git', 'config', '--get', f'remote.{remote}.url') or remote)
    return 'github.com' in url


def pushed_refs(arguments, cwd):
    """The remote and the (source, destination branch) of each branch a `git push`
    updates on GitHub."""
    positional, words = [], iter(arguments)
    for word in words:
        if word in ('--delete', '-d', '--dry-run', '-n', '--help', '-h'):
            return None, []
        if word in PUSH_OPTIONS_WITH_VALUE:
            next(words, None)
        elif not word.startswith('-'):
            positional.append(word)
    current = run(cwd, 'git', 'symbolic-ref', '--short', '-q', 'HEAD')
    remote = positional[0] if positional else (
        run(cwd, 'git', 'config', f'branch.{current}.pushRemote')
        or run(cwd, 'git', 'config', 'remote.pushDefault')
        or run(cwd, 'git', 'config', f'branch.{current}.remote') or 'origin')
    if not on_github(cwd, remote):
        return remote, []
    if '--all' in arguments or '--branches' in arguments:
        branches = run(cwd, 'git', 'for-each-ref', '--format=%(refname:short)', 'refs/heads')
        return remote, [(branch, branch) for branch in branches.splitlines()]
    if len(positional) < 2:
        target = run(cwd, 'git', 'rev-parse', '--abbrev-ref', '--symbolic-full-name', '@{push}')
        return remote, [('HEAD', target.split('/', 1)[1] if '/' in target else current)]
    refs = []
    for spec in positional[1:]:
        source, _, destination = spec.partition(':')
        if not source:
            continue  # `:branch` deletes it
        destination = destination or source
        if destination == 'HEAD':
            destination = current
        refs.append((source, destination.removeprefix('refs/heads/')))
    return remote, refs


def ready_pull_request(branch, cwd):
    state = run(cwd, 'gh', 'pr', 'view', branch, '--json', 'state,isDraft',
                '--jq', '.state + " " + (.isDraft | tostring)')
    return state == 'OPEN false'


def full_ci_starts(words, cwd):
    """(what starts the run, the commit it tests, the checkout) for each full CI run
    `words` would start in a checkout with workflows. The commit is None when git
    or gh cannot say which one it is."""
    words = strip_prefix(words)
    if not words or flag(words, '--help', '-h'):
        return []
    name = words[0].rsplit('/', 1)[-1]
    if name == 'git':
        rest = words[1:]
        while rest and rest[0].startswith('-'):
            if rest[0] == '-C' and len(rest) > 1:
                cwd = str(Path(cwd, rest[1]))
            rest = rest[2:] if rest[0] in GIT_OPTIONS_WITH_VALUE else rest[1:]
        if not rest or rest[0] != 'push' or not workflows(cwd):
            return []
        remote, refs = pushed_refs(rest[1:], cwd)
        if remote != 'origin':
            return []  # gh reads the default branch and pull requests of origin's repository
        default = default_branch(cwd) if refs else None
        starts = []
        for source, destination in refs:
            if destination and destination == default:
                what = f'a push to {destination}'
            elif destination and ready_pull_request(destination, cwd):
                what = f'a push to ready pull request {destination}'
            else:
                continue
            starts.append((what, commit_of(cwd, source), cwd))
        return starts
    if name != 'gh' or flag(words, '--dry-run') or not workflows(cwd):
        return []
    repository = value(words, '-R', '--repo')
    if repository and repository.removesuffix('.git').lower() not in (
            run(cwd, 'git', 'config', '--get', 'remote.origin.url').lower()):
        return []  # another repository's releases are not recorded here
    words = [word for index, word in enumerate(words) if word not in ('-R', '--repo')
             and not word.startswith(('--repo=', '-R='))
             and (index == 0 or words[index - 1] not in ('-R', '--repo'))]
    if len(words) < 3:
        return []
    group, command, arguments = words[1], words[2], words[3:]
    if (group, command) == ('pr', 'ready') and not flag(arguments, '--undo'):
        target = operand(arguments)
        oid = run(cwd, 'gh', 'pr', 'view', *([target] if target else []), '--json', 'headRefOid',
                  '--jq', '.headRefOid')
        return [('marking the pull request ready', oid or None, cwd)]
    if (group, command) == ('pr', 'create') and not flag(arguments, '--draft', '-d'):
        head = value(arguments, '-H', '--head')
        return [('a pull request opened ready for review',
                 commit_of(cwd, head.rsplit(':', 1)[-1] if head else 'HEAD'), cwd)]
    if (group, command) == ('workflow', 'run'):
        ref = value(arguments, '-r', '--ref') or default_branch(cwd)
        return [('a manual workflow run', commit_of(cwd, f'origin/{ref}') or commit_of(cwd, ref)
                 if ref else None, cwd)]
    if (group, command) == ('run', 'rerun'):
        target = operand(arguments, {'-j', '--job'})
        sha = run(cwd, 'gh', 'run', 'view', target, '--json', 'headSha', '--jq', '.headSha') \
            if target else ''
        return [('a re-run', sha or None, cwd)]
    return []


def workflows(cwd):
    root = run(cwd, 'git', 'rev-parse', '--show-toplevel')
    folder = Path(root, '.github', 'workflows') if root else None
    return bool(folder and folder.is_dir() and any(folder.glob('*.y*ml')))


def release_marks(cwd):
    """Commits `effort-gate release` marked in the checkout's repository, or None
    when git cannot name the repository."""
    common = run(cwd, 'git', 'rev-parse', '--path-format=absolute', '--git-common-dir')
    if not common:
        return None
    try:
        lines = Path(common, 'agent-ci-release').read_text().splitlines()
    except OSError:
        return set()
    return {line.split('\t', 1)[0] for line in lines}


MOVES_HEAD = {'commit', 'merge', 'rebase', 'cherry-pick', 'revert', 'am', 'pull', 'reset',
              'switch', 'checkout'}


def unreleased_ci(commands, cwd):
    """(what, commit) for the first full CI run the commands would start for an
    unmarked commit. A plain `cd <dir>` moves the commands after it; anything
    subtler is not followed. After a git command that can move HEAD, the commit
    is one this hook cannot see yet, so it has no mark: `None`."""
    moved = False
    for words in commands:
        plain = strip_prefix(words)
        if len(plain) == 2 and plain[0] == 'cd':
            cwd = str(Path(cwd, plain[1]).expanduser())
            continue
        marks = None
        for what, commit, checkout in full_ci_starts(words, cwd):
            if moved:
                return what, None
            marks = release_marks(checkout) if marks is None else marks
            if commit and marks is not None and commit not in marks:
                return what, commit
        if plain and plain[0].rsplit('/', 1)[-1] == 'git':
            rest = plain[1:]
            while rest and rest[0].startswith('-'):
                rest = rest[2:] if rest[0] in GIT_OPTIONS_WITH_VALUE else rest[1:]
            moved = moved or bool(rest and rest[0] in MOVES_HEAD)
    return None


def shell_text(command):
    """Codex may pass argv (`["bash", "-lc", "<script>"]`); Claude passes a string."""
    if isinstance(command, list):
        if len(command) >= 3 and command[1] in ('-c', '-lc'):
            return str(command[2])
        return shlex.join(str(word) for word in command)
    return str(command or '')


def main():
    try:
        event = json.loads(sys.stdin.read() or '{}')
    except ValueError:
        return 0
    if not isinstance(event, dict) or event.get('tool_name') != 'Bash':
        return 0
    try:
        commands = simple_commands(shell_text((event.get('tool_input') or {}).get('command')))
    except ValueError:
        return 0
    if any(force_push(words) for words in commands):
        reason = ('Force-push rewrites remote history. On your own branch use '
                  '--force-with-lease; anything else needs Sebastian.')
    elif any(lists_arguments(words) for words in commands):
        reason = ('Process arguments can carry secrets, and this listing would copy them into '
                  'the transcript. List names only: `ps -Ao pid,rss,comm`, `pgrep -x <name>`, '
                  'or `pgrep -f <pattern>` for PIDs.')
    elif (start := unreleased_ci(commands, event.get('cwd') or '.')):
        what, commit = start
        subject = (f'commit {commit[:12]} is not a release' if commit else
                   'the commit this command makes is not a release yet (commit first, then '
                   'mark it, then push in its own command)')
        reason = (f'{what[0].upper()}{what[1:]} starts a full run on the CI farm every session '
                  f'shares, and {subject}. CI is the release gate, '
                  'not the test loop: iterate on a local build (the fast CI steps, affected '
                  'tests, the walk, review) until no finding is open, batching every finding '
                  'into one change. Keep an iterating pull request in draft (`gh pr ready '
                  '--undo`). When this commit is the release, record it with `python3 '
                  '~/dotfiles/bin/effort-gate release "<why this commit is the release>"` '
                  'and run the command again.')
    else:
        return 0
    print(json.dumps({'hookSpecificOutput': {
        'hookEventName': 'PreToolUse',
        'permissionDecision': 'deny',
        'permissionDecisionReason': reason}}))
    return 0


if __name__ == '__main__':
    sys.exit(main())
