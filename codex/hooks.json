{
  "hooks": {
    "PreToolUse": [
      {"hooks": [{"type": "command", "command": "python3 ~/dotfiles/bin/agent-tripwire", "timeout": 10}]}
    ],
    "UserPromptSubmit": [
      {"hooks": [{"type": "command", "command": "TZ=Europe/Stockholm date '+Local time: %a %Y-%m-%d %H:%M %Z'", "timeout": 5}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "python3 ~/dotfiles/bin/effort-gate stop", "timeout": 10}]}
    ],
    "SessionStart": [
      {"matcher": "compact", "hooks": [{"type": "command", "command": "python3 ~/dotfiles/bin/effort-gate context", "timeout": 10}]}
    ]
  }
}
