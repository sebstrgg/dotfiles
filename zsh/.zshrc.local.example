# ~/.zshrc.local — machine-local zsh overrides (NOT committed; lives in $HOME).
#
# This file is sourced near the end of ~/.zshrc, after every plugin and prompt,
# and immediately before zoxide. It exists so that installers which append to
# your rc (bun, rustup, tool completions, …) write HERE
# instead of corrupting the tracked ~/.zshrc.
#
# `dots-doctor --fix` will seed this file by extracting installer blocks from an
# existing ~/.zshrc the first time. After that, manage it by hand or let
# installers append to it freely.

# ── Example: bun installer block ──────────────────────
# [ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
# export BUN_INSTALL="$HOME/.bun"
# export PATH="$BUN_INSTALL/bin:$PATH"

# ── Example: a tool that ships zsh completion ─────────
# if command -v entire &>/dev/null; then
#   autoload -Uz compinit && compinit
#   source <(entire completion zsh)
# fi
